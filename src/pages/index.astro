---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout title="OurPortfolios — investment research with a method">
  <Navbar variant="marketing" />

  <main>
    <!-- Hero: establish the brand, not the product mechanics. -->
    <section class="hero" aria-label="OurPortfolios introduction">
      <div class="hero-copy">
        <p class="eyebrow">Investment research, with a method</p>
        <h1>Find a method.<br /><em>Research with it.</em></h1>
        <p class="hero-lede">
          OurPortfolios brings established investment frameworks into the company research you already do.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://app.ourportfolios.net">Start exploring</a>
          <a class="btn btn-ghost" href="#frameworks">See how it works</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <svg class="lens-art" viewBox="0 0 760 620" role="presentation">
          <defs>
            <linearGradient id="steel-copper" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#7890a3" />
              <stop offset="0.48" stop-color="#c9a487" />
              <stop offset="1" stop-color="#8f6048" />
            </linearGradient>
            <linearGradient id="steel-light" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#36434f" />
              <stop offset="0.52" stop-color="#8ca2b3" />
              <stop offset="1" stop-color="#d5b296" />
            </linearGradient>
            <radialGradient id="lens-fill" cx="42%" cy="35%" r="72%">
              <stop offset="0" stop-color="#d9b79b" stop-opacity=".34" />
              <stop offset=".42" stop-color="#8ba1b2" stop-opacity=".18" />
              <stop offset="1" stop-color="#07090c" stop-opacity=".04" />
            </radialGradient>
            <filter id="soft-shadow" x="-40%" y="-40%" width="180%" height="180%">
              <feGaussianBlur stdDeviation="18" />
            </filter>
            <clipPath id="lens-clip">
              <ellipse cx="430" cy="310" rx="214" ry="245" transform="rotate(-22 430 310)" />
            </clipPath>
          </defs>

          <g class="hero-noise">
            <circle cx="80" cy="104" r="2" /><circle cx="136" cy="180" r="2" />
            <circle cx="204" cy="88" r="1.6" /><circle cx="278" cy="148" r="2" />
            <circle cx="334" cy="72" r="1.4" /><circle cx="590" cy="92" r="2" />
            <circle cx="650" cy="164" r="1.6" /><circle cx="706" cy="106" r="2" />
            <circle cx="600" cy="510" r="1.6" /><circle cx="680" cy="470" r="2" />
            <circle cx="548" cy="560" r="1.4" /><circle cx="160" cy="492" r="2" />
            <circle cx="86" cy="410" r="1.6" /><circle cx="234" cy="548" r="2" />
          </g>

          <g class="hero-traces">
            <path d="M32 268 C174 190 252 218 326 274 S486 388 730 302" />
            <path d="M44 372 C186 308 260 330 350 388 S514 494 728 406" />
            <path d="M160 80 C248 182 312 194 392 168 S546 82 688 196" />
          </g>

          <ellipse class="lens-shadow" cx="430" cy="332" rx="205" ry="226" transform="rotate(-22 430 332)" />
          <ellipse class="lens-body" cx="430" cy="310" rx="214" ry="245" transform="rotate(-22 430 310)" />
          <ellipse class="lens-inner" cx="430" cy="310" rx="190" ry="220" transform="rotate(-22 430 310)" />

          <g class="lens-content" clip-path="url(#lens-clip)">
            <path class="focus-trace" d="M80 360 C230 254 332 266 424 324 S594 420 782 280" />
            <path class="focus-trace second" d="M80 438 C220 342 326 354 430 410 S594 490 770 366" />
            <circle cx="326" cy="274" r="7" /><circle cx="382" cy="298" r="5" />
            <circle cx="448" cy="334" r="8" /><circle cx="520" cy="360" r="5" />
            <circle cx="578" cy="382" r="7" /><circle cx="410" cy="410" r="4" />
            <circle cx="492" cy="434" r="6" />
          </g>

          <ellipse class="lens-highlight" cx="390" cy="245" rx="130" ry="62" transform="rotate(-22 390 245)" />
          <ellipse class="lens-edge" cx="430" cy="310" rx="214" ry="245" transform="rotate(-22 430 310)" />
        </svg>
      </div>
    </section>

    <!-- Problem: show the information overload without adding another dashboard. -->
    <section class="noise-section" aria-labelledby="noise-title">
      <div class="noise-copy">
        <p class="eyebrow">The problem</p>
        <h2 id="noise-title">The market gives you everything.<br /><em>It does not tell you what matters.</em></h2>
      </div>

      <div class="signal-field" aria-hidden="true">
        <div class="signal-orbit orbit-one"></div>
        <div class="signal-orbit orbit-two"></div>
        <div class="signal-orbit orbit-three"></div>
        <div class="signal-cluster">
          <span style="--x: 8%; --y: 25%"></span><span style="--x: 18%; --y: 68%"></span>
          <span style="--x: 27%; --y: 42%"></span><span style="--x: 36%; --y: 16%"></span>
          <span style="--x: 42%; --y: 73%"></span><span style="--x: 51%; --y: 32%"></span>
          <span style="--x: 58%; --y: 61%"></span><span style="--x: 66%; --y: 20%"></span>
          <span style="--x: 74%; --y: 48%"></span><span style="--x: 84%; --y: 28%"></span>
          <span style="--x: 91%; --y: 70%"></span><span style="--x: 33%; --y: 88%"></span>
          <span style="--x: 62%; --y: 88%"></span><span style="--x: 79%; --y: 78%"></span>
        </div>
      </div>
    </section>

    <!-- Framework library: visual first, minimal copy. -->
    <section class="frameworks-section" id="frameworks" aria-labelledby="frameworks-title">
      <div class="section-heading">
        <p class="eyebrow">Frameworks</p>
        <h2 id="frameworks-title">Start with a way of thinking.</h2>
        <p>Learn how established investors approach a company, then apply the same method across the market.</p>
      </div>

      <div class="framework-gallery">
        <article class="framework-card buffett is-featured">
          <div class="framework-card-top"><span>01</span><span>Fundamental</span></div>
          <div class="framework-glyph glyph-buffett"><i></i><i></i><i></i></div>
          <h3>Warren Buffett</h3>
          <p>Business quality, economics, capital and valuation.</p>
          <span class="framework-arrow">Explore framework <b>↗</b></span>
        </article>

        <article class="framework-card lynch">
          <div class="framework-card-top"><span>02</span><span>Fundamental</span></div>
          <div class="framework-glyph glyph-lynch"><i></i><i></i><i></i><i></i></div>
          <h3>Peter Lynch</h3>
          <p>Growth, business fundamentals and the story behind the numbers.</p>
          <span class="framework-arrow">Explore framework <b>↗</b></span>
        </article>

        <article class="framework-card technical">
          <div class="framework-card-top"><span>03</span><span>Technical</span></div>
          <div class="framework-glyph glyph-technical"><i></i><i></i><i></i></div>
          <h3>Technical analysis</h3>
          <p>Price, momentum and market structure through a different lens.</p>
          <span class="framework-arrow">Explore framework <b>↗</b></span>
        </article>
      </div>
    </section>

    <!-- Product idea: cursor-following lens, not a fake dashboard. -->
    <section class="lens-section" aria-labelledby="lens-title">
      <div class="section-heading compact">
        <p class="eyebrow">See the difference</p>
        <h2 id="lens-title">One company.<br /><em>Different methods.</em></h2>
        <p>Move across the research surface. The lens follows you and shows how a framework changes what deserves attention.</p>
      </div>

      <div class="lens-demo" id="lens-demo" data-framework="buffett">
        <div class="lens-demo-head">
          <div><span class="mini-label">Research view</span><strong>Company overview</strong></div>
          <div class="lens-tabs" role="group" aria-label="Choose framework">
            <button class="lens-tab is-active" type="button" data-lens-framework="buffett">Buffett</button>
            <button class="lens-tab" type="button" data-lens-framework="lynch">Lynch</button>
          </div>
        </div>

        <div class="lens-columns">
          <div class="research-pane all-pane">
            <span class="pane-title">Full research</span>
            <div class="research-field" data-field="all">
              <div class="field-line line-a"></div><div class="field-line line-b"></div><div class="field-line line-c"></div>
              <div class="field-signal s1"></div><div class="field-signal s2"></div><div class="field-signal s3"></div>
              <div class="field-signal s4"></div><div class="field-signal s5"></div><div class="field-signal s6"></div>
              <div class="field-signal s7"></div><div class="field-signal s8"></div><div class="field-signal s9"></div>
              <div class="field-signal s10"></div><div class="field-signal s11"></div><div class="field-signal s12"></div>
            </div>
          </div>

          <div class="research-pane focus-pane">
            <span class="pane-title" data-focus-title>Buffett framework</span>
            <div class="research-field focus-field">
              <div class="field-line line-a"></div><div class="field-line line-b"></div><div class="field-line line-c"></div>
              <div class="field-signal s1"></div><div class="field-signal s2"></div><div class="field-signal s3"></div>
              <div class="field-signal s4"></div><div class="field-signal s5"></div><div class="field-signal s6"></div>
              <div class="field-signal s7"></div><div class="field-signal s8"></div><div class="field-signal s9"></div>
              <div class="field-signal s10"></div><div class="field-signal s11"></div><div class="field-signal s12"></div>
            </div>
          </div>

          <div class="cursor-lens" id="cursor-lens" aria-hidden="true">
            <div class="cursor-lens-inner"></div>
          </div>
        </div>
        <p class="lens-hint">Move your cursor across the surface</p>
      </div>
    </section>

    <!-- Product breadth: one surface, multiple research modes. -->
    <section class="product-section" aria-labelledby="product-title">
      <div class="product-copy">
        <p class="eyebrow">The research platform</p>
        <h2 id="product-title">Everything around the company.<br /><em>Nothing in the way.</em></h2>
        <p>Company research, financial statements, charts, comparisons, screening and portfolios, connected by the same underlying framework.</p>
      </div>

      <div class="product-stage" aria-hidden="true">
        <div class="product-nav">
          <span class="active">Company</span><span>Financials</span><span>Charts</span><span>Compare</span><span>Screen</span>
        </div>
        <div class="product-main">
          <div class="product-chart">
            <div class="chart-grid"></div>
            <svg viewBox="0 0 620 300" preserveAspectRatio="none">
              <path d="M0 252 C56 242 78 206 126 214 S198 260 244 202 S318 122 362 154 S418 194 462 118 S522 92 620 42" />
            </svg>
            <div class="chart-point p1"></div><div class="chart-point p2"></div><div class="chart-point p3"></div>
          </div>
          <div class="product-side">
            <div class="side-block"><span></span><i></i><b></b></div>
            <div class="side-block selected"><span></span><i></i><b></b></div>
            <div class="side-block"><span></span><i></i><b></b></div>
          </div>
        </div>
        <div class="product-footer"><span>Framework</span><strong>Buffett</strong><span class="product-status">Applied to research</span></div>
      </div>
    </section>

    <!-- Philosophy / trust: no black-box positioning. -->
    <section class="principles-section" aria-labelledby="principles-title">
      <div class="principles-heading">
        <p class="eyebrow">A different approach</p>
        <h2 id="principles-title">Don't outsource the decision.<br /><em>Build the reasoning.</em></h2>
      </div>
      <div class="principles-grid">
        <article><span>01</span><h3>Learn</h3><p>Understand the methods behind established investors instead of starting from a blank page.</p></article>
        <article><span>02</span><h3>Apply</h3><p>Put a framework on any company and see the information through that method.</p></article>
        <article><span>03</span><h3>Decide</h3><p>Use transparent data and your own judgement. No black-box recommendation required.</p></article>
      </div>
    </section>

    <section class="climax" aria-label="Start exploring">
      <div class="climax-inner">
        <p class="eyebrow">Your research, your method</p>
        <h2>Build your way of investing.</h2>
        <p>Learn established methods, apply them to real companies, and make the decision yourself.</p>
        <a class="btn btn-invert" href="https://app.ourportfolios.net">Start exploring</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand"><span class="footer-wordmark">OurPortfolios</span><span class="footer-tag">Built to educate, not to sell.</span></div>
      <nav aria-label="Footer">
        <a href="https://app.ourportfolios.net/tickers">Markets</a>
        <a href="https://app.ourportfolios.net/industry">Analysis</a>
        <a href="https://app.ourportfolios.net/framework">Method</a>
      </nav>
      <span class="footer-copy">2026 OurPortfolios</span>
    </div>
  </footer>
</BaseLayout>

<script>
  const lensDemo = document.querySelector<HTMLElement>("#lens-demo");
  const cursorLens = document.querySelector<HTMLElement>("#cursor-lens");
  const lensTabs = document.querySelectorAll<HTMLButtonElement>("[data-lens-framework]");
  const focusTitle = document.querySelector<HTMLElement>("[data-focus-title]");

  if (lensDemo && cursorLens) {
    const moveLens = (event: PointerEvent) => {
      const rect = lensDemo.getBoundingClientRect();
      const x = Math.max(40, Math.min(rect.width - 40, event.clientX - rect.left));
      const y = Math.max(40, Math.min(rect.height - 40, event.clientY - rect.top));
      cursorLens.style.transform = `translate3d(${x - 82}px, ${y - 82}px, 0)`;
      cursorLens.classList.add("is-visible");
    };

    lensDemo.addEventListener("pointermove", moveLens);
    lensDemo.addEventListener("pointerenter", moveLens);
    lensDemo.addEventListener("pointerleave", () => cursorLens.classList.remove("is-visible"));

    lensTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const framework = tab.dataset.lensFramework || "buffett";
        lensDemo.dataset.framework = framework;
        lensTabs.forEach((item) => item.classList.toggle("is-active", item === tab));
        if (focusTitle) focusTitle.textContent = `${framework === "lynch" ? "Lynch" : "Buffett"} framework`;
      });
    });
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  h1, h2, h3, p { margin: 0; }
  section { position: relative; }

  .hero {
    min-height: calc(100svh - 64px);
    max-width: 1380px;
    margin: 0 auto;
    padding: 62px 54px 84px;
    display: grid;
    grid-template-columns: minmax(420px, .8fr) minmax(560px, 1.2fr);
    align-items: center;
    gap: 20px;
    overflow: hidden;
  }
  .hero-copy { position: relative; z-index: 2; max-width: 610px; }
  .eyebrow {
    margin-bottom: 22px;
    color: var(--text-2);
    font-size: 11px;
    font-weight: 650;
    letter-spacing: .105em;
    text-transform: uppercase;
  }
  h1, h2, h3 { font-family: var(--display); }
  h1 {
    max-width: 700px;
    font-size: clamp(66px, 7.2vw, 108px);
    line-height: .9;
    letter-spacing: -.058em;
    font-weight: 700;
  }
  h1 em, h2 em { color: var(--accent-warm); font-style: normal; }
  .hero-lede {
    max-width: 470px;
    margin-top: 34px;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.62;
  }
  .hero-actions { display: flex; align-items: center; gap: 12px; margin-top: 36px; }

  .hero-art { min-height: 650px; display: grid; place-items: center; }
  .lens-art { width: 118%; height: auto; overflow: visible; transform: translate(4%, 1%) rotate(-8deg); }
  .hero-noise circle { fill: var(--text-2); opacity: .28; animation: drift 7s ease-in-out infinite; }
  .hero-noise circle:nth-child(2n) { animation-delay: -2s; }
  .hero-noise circle:nth-child(3n) { animation-delay: -4s; }
  .hero-traces path { fill: none; stroke: color-mix(in srgb, var(--text-2) 20%, transparent); stroke-width: 1.5; }
  .hero-traces path:nth-child(2) { stroke: color-mix(in srgb, var(--accent-warm) 22%, transparent); }
  .lens-shadow { fill: #000; opacity: .5; filter: url(#soft-shadow); transform-origin: center; }
  .lens-body { fill: url(#lens-fill); stroke: color-mix(in srgb, var(--text-1) 24%, transparent); stroke-width: 2; }
  .lens-inner { fill: none; stroke: url(#steel-copper); stroke-opacity: .62; stroke-width: 1.2; }
  .lens-content path { fill: none; stroke: url(#steel-copper); stroke-width: 4; opacity: .82; }
  .lens-content .second { opacity: .4; stroke-width: 2; }
  .lens-content circle { fill: var(--accent-warm); opacity: .85; }
  .lens-highlight { fill: #fff; opacity: .075; }
  .lens-edge { fill: none; stroke: color-mix(in srgb, var(--accent-warm) 42%, transparent); stroke-width: 2; stroke-dasharray: 180 900; animation: edge 9s linear infinite; }

  .noise-section { max-width: 1240px; margin: 0 auto; padding: 145px 48px 175px; }
  .noise-copy { max-width: 860px; }
  h2 { font-size: clamp(48px, 5.3vw, 76px); line-height: .94; letter-spacing: -.052em; font-weight: 700; }
  .signal-field {
    position: relative;
    height: 360px;
    margin-top: 68px;
    overflow: hidden;
    border-radius: 26px;
    background: linear-gradient(135deg, var(--surface-1), color-mix(in srgb, var(--surface-2) 72%, var(--canvas)));
    border: 1px solid var(--hairline);
  }
  .signal-orbit { position: absolute; border: 1px solid color-mix(in srgb, var(--text-2) 12%, transparent); border-radius: 50%; transform: rotate(-14deg); }
  .orbit-one { width: 76%; height: 220px; left: 12%; top: 65px; }
  .orbit-two { width: 58%; height: 310px; left: 22%; top: 20px; transform: rotate(24deg); }
  .orbit-three { width: 88%; height: 120px; left: 6%; top: 118px; border-color: color-mix(in srgb, var(--accent-warm) 12%, transparent); }
  .signal-cluster span { position: absolute; left: var(--x); top: var(--y); width: 7px; height: 7px; border-radius: 50%; background: var(--text-2); opacity: .48; box-shadow: 0 0 0 7px color-mix(in srgb, var(--text-2) 4%, transparent); animation: pulse 3.5s ease-in-out infinite; }
  .signal-cluster span:nth-child(3n) { background: var(--accent-warm); opacity: .7; animation-delay: -1.2s; }

  .frameworks-section { max-width: 1240px; margin: 0 auto; padding: 120px 48px 170px; }
  .section-heading { max-width: 790px; }
  .section-heading > p:last-child { max-width: 600px; margin-top: 26px; color: var(--text-2); font-size: 16px; line-height: 1.65; }
  .framework-gallery { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 14px; margin-top: 58px; }
  .framework-card { min-height: 460px; padding: 25px; border: 1px solid var(--hairline); border-radius: 24px; background: var(--surface-1); display: flex; flex-direction: column; overflow: hidden; transition: transform .45s ease, border-color .45s ease; }
  .framework-card:hover { transform: translateY(-5px); border-color: color-mix(in srgb, var(--accent-warm) 30%, transparent); }
  .framework-card-top { display: flex; justify-content: space-between; color: var(--text-2); font-size: 10px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
  .framework-card h3 { margin-top: auto; font-size: 30px; letter-spacing: -.04em; }
  .framework-card p { max-width: 300px; margin-top: 10px; color: var(--text-2); font-size: 14px; line-height: 1.55; }
  .framework-arrow { margin-top: 25px; color: var(--text-1); font-size: 12px; font-weight: 600; }
  .framework-arrow b { margin-left: 6px; color: var(--accent-warm); font-size: 15px; }
  .framework-glyph { position: relative; height: 220px; margin: 28px -8px 20px; overflow: hidden; }
  .glyph-buffett i { position: absolute; width: 220px; height: 220px; border: 1px solid color-mix(in srgb, var(--accent-warm) 40%, transparent); border-radius: 50%; transform: rotate(28deg) skewX(-12deg); }
  .glyph-buffett i:nth-child(1) { left: 8%; top: 0; }
  .glyph-buffett i:nth-child(2) { left: 24%; top: -10px; opacity: .55; }
  .glyph-buffett i:nth-child(3) { left: 40%; top: 6px; opacity: .28; }
  .glyph-lynch { display: flex; align-items: end; gap: 9px; padding: 18px 30px; }
  .glyph-lynch i { flex: 1; border-radius: 8px 8px 2px 2px; background: linear-gradient(to top, color-mix(in srgb, var(--accent-warm) 24%, transparent), color-mix(in srgb, var(--text-2) 35%, transparent)); animation: bars 3.4s ease-in-out infinite alternate; }
  .glyph-lynch i:nth-child(1) { height: 32%; }.glyph-lynch i:nth-child(2) { height: 52%; animation-delay: -.7s; }.glyph-lynch i:nth-child(3) { height: 76%; animation-delay: -1.4s; }.glyph-lynch i:nth-child(4) { height: 92%; animation-delay: -2s; }
  .glyph-technical i { position: absolute; left: 12%; width: 76%; height: 1px; background: color-mix(in srgb, var(--text-2) 22%, transparent); transform-origin: left; }
  .glyph-technical i:nth-child(1) { top: 44%; transform: rotate(-18deg); background: var(--accent-warm); }.glyph-technical i:nth-child(2) { top: 54%; transform: rotate(12deg); }.glyph-technical i:nth-child(3) { top: 68%; transform: rotate(-9deg); opacity: .5; }

  .lens-section { max-width: 1240px; margin: 0 auto; padding: 110px 48px 170px; }
  .compact { max-width: 820px; }
  .lens-demo { position: relative; margin-top: 58px; padding: 26px; border-radius: 26px; background: var(--surface-1); border: 1px solid var(--hairline); overflow: hidden; }
  .lens-demo-head { position: relative; z-index: 4; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 2px 2px 24px; }
  .lens-demo-head div:first-child { display: flex; flex-direction: column; gap: 5px; }
  .mini-label, .pane-title { color: var(--text-2); font-size: 10px; font-weight: 650; letter-spacing: .09em; text-transform: uppercase; }
  .lens-demo-head strong { font-family: var(--display); font-size: 20px; letter-spacing: -.025em; }
  .lens-tabs { display: flex !important; gap: 5px; }
  .lens-tab { border: 1px solid var(--hairline); border-radius: 999px; background: transparent; color: var(--text-2); padding: 8px 14px; font: 600 11px/1 var(--sans); cursor: pointer; }
  .lens-tab.is-active { color: var(--canvas); background: var(--text-1); border-color: var(--text-1); }
  .lens-columns { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; min-height: 430px; border-radius: 18px; overflow: hidden; background: var(--hairline); }
  .research-pane { position: relative; padding: 24px; background: var(--surface-1); }
  .focus-pane { background: color-mix(in srgb, var(--surface-2) 65%, var(--surface-1)); }
  .research-field { position: absolute; inset: 70px 24px 24px; overflow: hidden; }
