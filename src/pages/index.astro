---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout title="OurPortfolios — research with a method">
  <Navbar variant="marketing" />

  <main>
    <section class="hero" aria-label="OurPortfolios introduction">
      <div class="hero-copy">
        <h1>Research is complex.<br /><em>Finding what matters</em> shouldn't be.</h1>
        <p>OurPortfolios gives you a way to study companies through investment frameworks — without hiding the underlying research.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://app.ourportfolios.net">Start exploring</a>
          <a class="btn btn-ghost" href="https://app.ourportfolios.net/framework">Explore frameworks</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="art-glow"></div>
        <div class="art-orbit orbit-a"></div>
        <div class="art-orbit orbit-b"></div>
        <div class="art-orbit orbit-c"></div>
        <div class="art-core"><span></span></div>
        <div class="art-trace trace-a"></div>
        <div class="art-trace trace-b"></div>
        <div class="art-trace trace-c"></div>
        <div class="art-noise"></div>
      </div>
    </section>

    <section class="statement">
      <h2>The market gives you<br /><em>more information</em> than you can use.</h2>
    </section>

    <section class="field-section" aria-label="Information and focus">
      <div class="field-art" aria-hidden="true">
        <div class="field-grid"></div>
        <div class="field-points">
          {Array.from({ length: 42 }).map((_, i) => <i style={`--i:${i}`}></i>)}
        </div>
        <div class="focus-ring"></div>
        <div class="focus-line"></div>
      </div>
      <div class="field-copy">
        <h2>A method changes<br /><em>what you see.</em></h2>
        <p>Frameworks turn a body of research into a repeatable way of looking at a company. The information stays there. The emphasis changes.</p>
      </div>
    </section>

    <section class="framework-demo" id="framework" aria-label="Framework demonstration">
      <div class="demo-heading">
        <h2>One company.<br /><em>Different lenses.</em></h2>
      </div>

      <div class="lens-stage">
        <div class="lens-surface">
          <div class="surface-grid"></div>
          <div class="surface-lines line-1"></div>
          <div class="surface-lines line-2"></div>
          <div class="surface-lines line-3"></div>
          <div class="surface-nodes">
            {Array.from({ length: 24 }).map((_, i) => <i style={`--i:${i}`}></i>)}
          </div>
        </div>
        <div class="lens"></div>
        <div class="lens-highlight"></div>
      </div>

      <p class="demo-caption">The research doesn't change.<br /><strong>Your way of reading it does.</strong></p>
    </section>

    <section class="product-section" aria-label="OurPortfolios product">
      <div class="product-copy">
        <h2>Everything you need<br /><em>in one research surface.</em></h2>
        <p>Explore companies, financials, charts, comparisons and screening. Then apply a framework to the same underlying research.</p>
      </div>

      <div class="product-window" aria-hidden="true">
        <div class="window-top">
          <span class="window-dot"></span><span class="window-dot"></span><span class="window-dot"></span>
          <div class="window-address"></div>
        </div>
        <div class="window-body">
          <aside>
            <div class="side-mark"></div>
            <i class="side-line wide"></i><i class="side-line"></i><i class="side-line"></i><i class="side-line short"></i>
            <div class="side-gap"></div>
            <i class="side-line"></i><i class="side-line short"></i>
          </aside>
          <div class="research-surface">
            <div class="surface-header"><div class="header-block"></div><div class="header-pills"><i></i><i></i></div></div>
            <div class="research-layout">
              <div class="main-panel">
                <div class="panel-title"></div>
                <div class="chart-area"><div class="chart-fill"></div><svg viewBox="0 0 700 250" preserveAspectRatio="none"><path d="M0 206 C70 198 88 165 145 179 S220 224 280 168 S360 103 420 132 S505 171 548 105 S625 82 700 40" /></svg></div>
              </div>
              <div class="side-panel"><i></i><i></i><i class="active"></i><i></i><i></i></div>
            </div>
            <div class="research-rows"><i></i><i></i><i></i><i></i></div>
          </div>
        </div>
      </div>
    </section>

    <section class="closing-statement">
      <h2>Don't simplify<br /><em>the decision.</em></h2>
      <p>Make the reasoning easier to see.</p>
    </section>

    <section class="climax" aria-label="Start exploring">
      <div class="climax-inner">
        <h2>Roll credits on guesswork.</h2>
        <p>Every number explained, every chart annotated, every claim sourced. The methodology is open-source, on the record, and free to check.</p>
        <a class="btn btn-invert" href="https://app.ourportfolios.net">Start exploring</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-wordmark">OurPortfolios</span>
      <nav aria-label="Footer"><a href="https://app.ourportfolios.net/tickers">Markets</a><a href="https://app.ourportfolios.net/industry">Analysis</a><a href="https://app.ourportfolios.net/framework">Method</a></nav>
      <span class="footer-copy">2026 OurPortfolios</span>
    </div>
  </footer>
</BaseLayout>

<style>
  h1,h2,p { margin: 0; }
  em { color: var(--accent-warm); font-style: normal; }

  .hero {
    min-height: calc(100svh - 64px);
    max-width: 1440px;
    margin: 0 auto;
    padding: 84px 48px 72px;
    display: grid;
    grid-template-columns: minmax(420px, .78fr) minmax(580px, 1.22fr);
    align-items: center;
    gap: 32px;
  }
  .hero-copy { position: relative; z-index: 3; max-width: 650px; }
  h1 {
    font-family: var(--display);
    font-size: clamp(64px, 7vw, 106px);
    line-height: .86;
    letter-spacing: -.065em;
    font-weight: 700;
  }
  .hero-copy > p { max-width: 500px; margin-top: 34px; color: var(--text-2); font-size: 17px; line-height: 1.65; }
  .hero-actions { display: flex; gap: 10px; margin-top: 36px; }

  .hero-art {
    position: relative;
    height: min(700px, 74vh);
    min-height: 520px;
    overflow: hidden;
    isolation: isolate;
    perspective: 1200px;
  }
  .art-glow {
    position: absolute; width: 78%; aspect-ratio: 1; left: 14%; top: 5%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-warm) 35%, transparent), transparent 66%);
    filter: blur(38px); opacity: .55;
  }
  .art-orbit { position: absolute; border: 1px solid color-mix(in srgb, var(--text-1) 18%, transparent); border-radius: 50%; left: 50%; top: 50%; transform-style: preserve-3d; }
  .orbit-a { width: 76%; height: 42%; transform: translate(-50%, -50%) rotateX(68deg) rotateZ(-14deg); animation: orbit-a 14s linear infinite; }
  .orbit-b { width: 67%; height: 67%; transform: translate(-50%, -50%) rotateY(65deg) rotateZ(20deg); border-color: color-mix(in srgb, var(--accent-warm) 36%, transparent); animation: orbit-b 17s linear infinite; }
  .orbit-c { width: 44%; height: 72%; transform: translate(-50%, -50%) rotateX(68deg) rotateZ(54deg); animation: orbit-c 11s linear infinite reverse; }
  .art-core { position:absolute; left:50%; top:50%; width:28%; aspect-ratio:1; transform:translate(-50%,-50%); border-radius:50%; background:radial-gradient(circle at 38% 34%, #e5b899 0%, #b0704a 22%, #56382c 50%, #171b20 72%); box-shadow: 0 0 90px color-mix(in srgb,var(--accent-warm) 28%,transparent); animation: breathe 5s ease-in-out infinite; }
  .art-core span { position:absolute; inset:18%; border:1px solid color-mix(in srgb,white 35%,transparent); border-radius:50%; }
  .art-trace { position:absolute; height:1px; background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--text-1) 42%,transparent),transparent); transform-origin:center; opacity:.7; }
  .trace-a{width:78%;left:11%;top:39%;transform:rotate(-18deg)} .trace-b{width:62%;left:20%;top:58%;transform:rotate(24deg)} .trace-c{width:48%;left:28%;top:73%;transform:rotate(-42deg)}
  .art-noise { position:absolute; inset:10%; opacity:.12; background-image:radial-gradient(circle,color-mix(in srgb,var(--text-1) 70%,transparent) 1px,transparent 1px); background-size:18px 18px; mask-image:radial-gradient(circle at center,#000,transparent 70%); animation: drift 12s linear infinite; }

  .statement { max-width: 1180px; margin: 0 auto; padding: 210px 48px 220px; }
  .statement h2, .demo-heading h2, .product-copy h2, .closing-statement h2 {
    font-family: var(--display); font-size: clamp(56px, 6.8vw, 96px); line-height: .88; letter-spacing: -.06em; font-weight: 700;
  }
  .statement h2 { max-width: 920px; }

  .field-section { min-height: 880px; position: relative; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; align-items: center; max-width: 1440px; margin: 0 auto; padding: 80px 48px; }
  .field-art { position:absolute; width:64%; height:82%; left:-8%; top:9%; transform:perspective(1200px) rotateY(18deg) rotateX(7deg) rotateZ(-4deg); }
  .field-grid { position:absolute; inset:0; background-image:linear-gradient(color-mix(in srgb,var(--text-1) 8%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--text-1) 8%,transparent) 1px,transparent 1px); background-size:72px 72px; mask-image:linear-gradient(90deg,#000,transparent 90%); }
  .field-points { position:absolute; inset:8%; }
  .field-points i { position:absolute; width:5px; height:5px; border-radius:50%; background:var(--text-1); left:calc((var(--i) * 37) % 100 * 1%); top:calc((var(--i) * 61) % 100 * 1%); opacity:calc(.12 + ((var(--i) % 5) * .08)); }
  .focus-ring { position:absolute; width:56%; aspect-ratio:1; left:27%; top:22%; border-radius:50%; border:1px solid color-mix(in srgb,var(--accent-warm) 60%,transparent); box-shadow:inset 0 0 80px color-mix(in srgb,var(--accent-warm) 12%,transparent),0 0 80px color-mix(in srgb,var(--accent-warm) 8%,transparent); animation:focus-pulse 6s ease-in-out infinite; }
  .focus-line { position:absolute; width:76%; height:1px; left:12%; top:50%; background:linear-gradient(90deg,transparent,var(--accent-warm),transparent); transform:rotate(-18deg); opacity:.65; }
  .field-copy { grid-column:2; justify-self:end; max-width:560px; position:relative; z-index:2; padding-right:5%; }
  .field-copy p, .product-copy p { max-width:470px; margin-top:32px; color:var(--text-2); font-size:17px; line-height:1.7; }

  .framework-demo { max-width: 1440px; margin: 0 auto; padding: 210px 48px 230px; }
  .demo-heading h2 { max-width: 820px; }
  .lens-stage { height: 620px; margin-top: 90px; position:relative; overflow:hidden; border-radius:34px; background:#0d1014; border:1px solid var(--hairline); perspective:1100px; }
  .lens-surface { position:absolute; inset:8% 10%; transform:rotateX(58deg) rotateZ(-12deg) translateY(-7%); transform-origin:center; background:linear-gradient(135deg,#12171d,#171d24); border:1px solid color-mix(in srgb,var(--text-1) 13%,transparent); overflow:hidden; }
  .surface-grid { position:absolute; inset:0; background-image:linear-gradient(color-mix(in srgb,var(--text-1) 8%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--text-1) 8%,transparent) 1px,transparent 1px); background-size:56px 56px; }
  .surface-lines { position:absolute; height:1px; background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--text-1) 30%,transparent),transparent); transform-origin:left; }.line-1{width:74%;top:34%;left:5%;transform:rotate(8deg)}.line-2{width:82%;top:59%;left:8%;transform:rotate(-14deg)}.line-3{width:60%;top:76%;left:22%;transform:rotate(21deg)}
  .surface-nodes i { position:absolute; width:8px;height:8px;border-radius:50%; background:var(--text-1); left:calc((var(--i) * 43) % 96 * 1%); top:calc((var(--i) * 67) % 88 * 1%); opacity:.35; }
  .lens { position:absolute; width:43%; aspect-ratio:1; left:28%; top:12%; border-radius:50%; background:radial-gradient(circle,transparent 54%,color-mix(in srgb,var(--accent-warm) 22%,transparent) 55%,transparent 69%); border:1px solid color-mix(in srgb,var(--accent-warm) 65%,transparent); box-shadow:0 0 100px color-mix(in srgb,var(--accent-warm) 13%,transparent); animation:lens-drift 8s ease-in-out infinite; }
  .lens::after { content:""; position:absolute; width:1px; height:160%; left:50%; top:-30%; background:linear-gradient(transparent,var(--accent-warm),transparent); transform:rotate(36deg); opacity:.65; }
  .lens-highlight { position:absolute; width:30%; aspect-ratio:1; left:34%; top:21%; border-radius:50%; background:radial-gradient(circle,color-mix(in srgb,#f0c5a5 42%,transparent),transparent 66%); filter:blur(25px); animation:lens-glow 8s ease-in-out infinite; }
  .demo-caption { margin-top:42px; color:var(--text-2); font-size:17px; line-height:1.55; }.demo-caption strong{color:var(--text-1);font-weight:600}

  .product-section { max-width: 1440px; margin: 0 auto; padding: 180px 48px 230px; }
  .product-copy { max-width: 780px; }
  .product-window { margin-top:90px; border:1px solid color-mix(in srgb,var(--text-1) 14%,transparent); border-radius:18px; background:#0e1115; overflow:hidden; box-shadow:0 50px 120px rgba(0,0,0,.3); transform:perspective(1800px) rotateX(2deg); }
  .window-top { height:46px; display:flex; align-items:center; gap:7px; padding:0 18px; border-bottom:1px solid var(--hairline); background:#111419; }.window-dot{width:7px;height:7px;border-radius:50%;background:#3b4046}.window-address{height:22px;max-width:420px;flex:1;margin-left:30px;border:1px solid var(--hairline);border-radius:6px}
  .window-body { min-height:610px; display:grid; grid-template-columns:180px 1fr; }
  .window-body aside { padding:34px 22px; border-right:1px solid var(--hairline); background:#0c0f13; }.side-mark{width:80px;height:12px;border-radius:3px;background:var(--text-1);opacity:.8;margin-bottom:50px}.side-line{display:block;height:7px;width:80%;border-radius:3px;background:var(--text-2);opacity:.18;margin:18px 0}.side-line.wide{width:100%;opacity:.35}.side-line.short{width:52%}.side-gap{height:80px}
  .research-surface { padding:38px 42px; }.surface-header{display:flex;justify-content:space-between;align-items:center}.header-block{width:180px;height:20px;background:var(--text-1);opacity:.7;border-radius:4px}.header-pills{display:flex;gap:7px}.header-pills i{display:block;width:46px;height:25px;border:1px solid var(--hairline);border-radius:999px}.research-layout{display:grid;grid-template-columns:1fr 190px;gap:20px;margin-top:42px}.main-panel,.side-panel{border:1px solid var(--hairline);background:#11151a;border-radius:10px}.main-panel{padding:24px}.panel-title{width:120px;height:10px;border-radius:3px;background:var(--text-2);opacity:.28}.chart-area{height:300px;margin-top:25px;position:relative;overflow:hidden}.chart-area::before{content:"";position:absolute;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--text-1) 7%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--text-1) 7%,transparent) 1px,transparent 1px);background-size:100% 60px,90px 100%}.chart-area svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.chart-area path{fill:none;stroke:var(--accent-warm);stroke-width:2}.chart-fill{position:absolute;left:0;right:0;bottom:0;height:42%;background:linear-gradient(180deg,color-mix(in srgb,var(--accent-warm) 10%,transparent),transparent);clip-path:polygon(0 80%,10% 74%,20% 82%,30% 62%,40% 68%,52% 42%,62% 55%,74% 28%,86% 34%,100% 0,100% 100%,0 100%)}.side-panel{padding:18px}.side-panel i{display:block;height:42px;margin-bottom:10px;border-radius:5px;background:var(--surface-2);border:1px solid var(--hairline)}.side-panel i.active{height:100px;background:linear-gradient(135deg,#171d23,#2c211c);border-color:color-mix(in srgb,var(--accent-warm) 50%,transparent)}.research-rows{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.research-rows i{height:54px;border:1px solid var(--hairline);border-radius:7px;background:#11151a}

  .closing-statement { max-width:1180px; margin:0 auto; padding:180px 48px 230px; }.closing-statement h2{max-width:820px}.closing-statement p{margin-top:35px;color:var(--text-2);font-size:18px}

  .climax { margin:0 24px 24px; min-height:600px; border-radius:28px; display:grid; place-items:center; text-align:center; padding:80px 30px; background:var(--gradient); color:var(--text-1); overflow:hidden; position:relative; }.climax::before{content:"";position:absolute;width:60%;aspect-ratio:1;border-radius:50%;right:-15%;top:-45%;background:radial-gradient(circle,color-mix(in srgb,#f2c5a8 20%,transparent),transparent 67%);filter:blur(20px)}.climax-inner{position:relative;z-index:1;max-width:720px}.climax h2{font-family:var(--display);font-size:clamp(56px,7vw,96px);line-height:.86;letter-spacing:-.06em}.climax p{max-width:540px;margin:30px auto 34px;color:color-mix(in srgb,var(--text-1) 72%,transparent);font-size:16px;line-height:1.65}
  .site-footer { padding: 32px 48px 50px; }.footer-inner{max-width:1360px;margin:0 auto;display:flex;align-items:center;gap:28px;color:var(--text-2);font-size:12px}.footer-wordmark{font-family:var(--display);font-size:16px;font-weight:700;color:var(--text-1)}.footer-inner nav{display:flex;gap:22px;margin-left:auto}.footer-inner a:hover{color:var(--text-1)}.footer-copy{opacity:.55}

  @keyframes orbit-a { to { transform:translate(-50%,-50%) rotateX(68deg) rotateZ(346deg); } }
  @keyframes orbit-b { to { transform:translate(-50%,-50%) rotateY(65deg) rotateZ(380deg); } }
  @keyframes orbit-c { to { transform:translate(-50%,-50%) rotateX(68deg) rotateZ(-306deg); } }
  @keyframes breathe { 0%,100%{transform:translate(-50%,-50%) scale(.96)}50%{transform:translate(-50%,-50%) scale(1.04)} }
  @keyframes drift { to { transform:translate(18px,12px) } }
  @keyframes focus-pulse { 0%,100%{transform:scale(.94);opacity:.65}50%{transform:scale(1.05);opacity:1} }
  @keyframes lens-drift { 0%,100%{transform:translate(-2%,0) scale(.98)}50%{transform:translate(5%,3%) scale(1.04)} }
  @keyframes lens-glow { 0%,100%{transform:scale(.9);opacity:.4}50%{transform:scale(1.15);opacity:.75} }

  @media (max-width: 1000px) {
    .hero{grid-template-columns:1fr;padding-top:70px}.hero-art{height:560px;min-height:0;margin-top:-10px}.field-section{grid-template-columns:1fr;min-height:820px}.field-art{width:90%;left:-28%;opacity:.8}.field-copy{grid-column:1;justify-self:start;margin-left:auto;max-width:620px}.window-body{grid-template-columns:110px 1fr}.window-body aside{padding:30px 16px}.research-layout{grid-template-columns:1fr}.side-panel{display:none}
  }
  @media (max-width: 680px) {
    .hero,.statement,.framework-demo,.product-section,.closing-statement{padding-left:22px;padding-right:22px}.hero{padding-top:58px;min-height:auto}.hero-copy>p{font-size:15px}.hero-actions{flex-wrap:wrap}.hero-art{height:430px}.statement{padding-top:130px;padding-bottom:140px}.field-section{padding:40px 22px;min-height:700px}.field-art{width:120%;left:-46%;top:5%;height:70%}.field-copy{padding-right:0;align-self:end;margin-bottom:35px}.framework-demo{padding-top:140px;padding-bottom:160px}.lens-stage{height:420px;margin-top:55px;border-radius:22px}.product-section{padding-top:130px;padding-bottom:160px}.product-window{margin-top:55px}.window-body{grid-template-columns:1fr}.window-body aside{display:none}.research-surface{padding:22px}.research-layout{margin-top:28px}.chart-area{height:230px}.research-rows{grid-template-columns:1fr 1fr}.closing-statement{padding-top:130px;padding-bottom:150px}.climax{margin:0 12px 12px;min-height:520px;border-radius:22px}.site-footer{padding:28px 22px 38px}.footer-inner{flex-wrap:wrap}.footer-inner nav{order:3;width:100%;margin-left:0}.footer-copy{margin-left:auto}
  }
  @media (prefers-reduced-motion: reduce) {
    .art-orbit,.art-core,.art-noise,.focus-ring,.lens,.lens-highlight{animation:none}
  }
</style>
