---
// Route / — OurPortfolios' point of view for individual investors.
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";

const APP = "https://app.ourportfolios.net";
---

<BaseLayout title="OurPortfolios — Put the question first">
  <Navbar variant="marketing" methodHref="#method" />

  <main>
    <section id="promise" class="promise" aria-labelledby="promise-title">
      <div class="promise-copy">
        <div class="promise-copy-inner">
          <h1 id="promise-title">Put the<br />question first.</h1>
          <p class="promise-support">A workspace for examining companies and industries.</p>
          <div class="promise-actions">
            <a class="btn btn-primary" href={APP}>Open the workspace</a>
            <a class="btn btn-ghost" href="/contacts">Talk to us</a>
          </div>
        </div>
      </div>
      <div class="promise-visual" aria-hidden="true">
        <img
          src="/assets/landing/hero/Swirl.jpeg"
          alt=""
          width="2752"
          height="1536"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </section>

    <section id="focus" class="focus" aria-labelledby="focus-title">
      <div class="shell focus-inner">
        <div class="focus-copy">
          <h2 id="focus-title">Bring one<br />thing forward.</h2>
        </div>
        <div class="focus-detail">
          <p class="focus-lead">Questions lead.</p>
          <div class="focus-divider" aria-hidden="true"></div>
          <p class="focus-lead">Context stays.</p>
        </div>
      </div>
    </section>

    <section id="method" class="method" aria-labelledby="method-title">
      <div class="shell">
        <h2 id="method-title">Question. Metrics. Evidence. Context.</h2>
        <ol class="method-sequence">
          <li>
            <h3>Question</h3>
            <p>Define the point of view.</p>
          </li>
          <li>
            <h3>Metrics</h3>
            <p>Give it weight.</p>
          </li>
          <li>
            <h3>Evidence</h3>
            <p>Test the view.</p>
          </li>
          <li>
            <h3>Context</h3>
            <p>Keep the frame.</p>
          </li>
        </ol>
      </div>
    </section>

    <section id="trust" class="trust" aria-labelledby="trust-title">
      <div class="shell trust-inner">
        <h2 id="trust-title">The judgment stays yours.</h2>
        <p>Organized analysis. Not a recommendation.</p>
      </div>
    </section>

    <!-- pre-footer climax CTA · the one full gradient; visual implementation preserved -->
    <section id="cta" class="climax" aria-label="Build your investing process.">
      <div class="climax-inner">
        <h2>Open the workspace.</h2>
        <p>Start with a question. Keep context in view.</p>
        <a class="btn btn-invert" href={APP}>Open the workspace</a>
      </div>
      <span class="fin" aria-hidden="true">OP</span>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <span class="footer-wordmark">OurPortfolios</span>
      <nav class="footer-links" aria-label="Footer">
        <a href={`${APP}/tickers`}>Markets</a>
        <a href={`${APP}/industry`}>Analysis</a>
        <a href="#method">Method</a>
        <a href="/contacts">Contact</a>
        <a href={APP}>Open workspace</a>
      </nav>
      <span class="footer-copy">2025 OurPortfolios</span>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }

  .shell {
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 0 32px;
  }

  h1, h2, h3, p, ol { margin: 0; }

  h1, h2 {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .promise {
    position: relative;
    isolation: isolate;
    height: 75svh;
    min-height: 520px;
    max-height: 880px;
    overflow: hidden;
    background: #000000;
  }

  .promise-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    min-width: 0;
    height: 100%;
    padding: clamp(32px, 4vw, 56px) clamp(24px, 4vw, 56px) clamp(36px, 5vw, 64px) 32px;
    background: transparent;
    pointer-events: none;
  }

  .promise-copy-inner {
    width: min(100%, 34rem);
    pointer-events: auto;
  }

  .promise h1 {
    max-width: 12ch;
    font-size: clamp(54px, 6vw, 86px);
    line-height: 0.95;
  }

  .promise-support {
    max-width: 32ch;
    margin-top: 22px;
    color: var(--text-2);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.5;
  }

  .promise-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 18px;
    margin-top: 32px;
  }

  .promise-actions .btn { min-height: 48px; }

  .promise-visual {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000000;
    pointer-events: none;
  }

  .promise-visual picture, .promise-visual img {
    display: block;
  }

  .promise-visual img {
    position: absolute;
    right: -10%;
    top: 0;
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: contain;
    background: #000000;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 12%, black 100%);
  }

  .focus {
    background: var(--canvas);
    padding: clamp(64px, 8vw, 120px) 0;
  }

  .focus-inner {
    display: grid;
    grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .focus-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    min-height: 100%;
    padding: 0;
  }

  .focus-copy h2 {
    max-width: 14ch;
    font-size: clamp(48px, 5.8vw, 78px);
    line-height: 0.96;
  }

  .focus-detail {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    min-width: 0;
    padding-left: clamp(28px, 4vw, 56px);
    border-left: 1px solid var(--surface-3);
  }

  .focus-lead {
    color: var(--text-1);
    font-family: var(--display);
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .focus-divider {
    width: 100%;
    height: 1px;
    background: var(--surface-3);
  }

  .method { padding: 138px 0 150px; background: var(--surface-1); }
  .method h2 { max-width: 17ch; font-size: clamp(46px, 5.8vw, 76px); }

  .method-sequence {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 92px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--surface-3);
  }

  .method-sequence li {
    display: grid;
    align-content: start;
    gap: 16px;
    min-height: 150px;
    padding: 24px 26px 0;
    border-left: 1px solid var(--surface-3);
  }

  .method-sequence li:first-child { padding-left: 0; border-left: 0; }
  .method-sequence h3 {
    color: var(--text-1);
    font-family: var(--display);
    font-size: clamp(24px, 2.5vw, 34px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .method-sequence p { max-width: 20ch; color: var(--text-2); font-size: 15px; line-height: 1.5; }

  .trust { padding: 144px 0 158px; background: var(--canvas); }
  .trust-inner { display: flex; align-items: end; justify-content: space-between; gap: 48px; }
  .trust h2 { max-width: 14ch; font-size: clamp(48px, 6vw, 78px); }
  .trust-inner > p { max-width: 22ch; padding-bottom: 4px; color: var(--text-2); font-size: 18px; line-height: 1.5; }

  /* pre-footer climax · the one full gradient */
  .climax { position: relative; overflow: hidden; background: var(--gradient); }
  .climax-inner { max-width: 1120px; margin: 0 auto; padding: 150px 32px 120px; }
  .climax h2 { max-width: 620px; font-family: var(--display); font-weight: 700; font-size: clamp(38px, 6vw, 72px); letter-spacing: -0.03em; line-height: 1; color: var(--text-1); text-wrap: balance; margin-bottom: 22px; }
  .climax p:not(.section-label) { max-width: 540px; font-size: 16.5px; line-height: 1.65; color: color-mix(in srgb, var(--text-1) 80%, transparent); margin-bottom: 36px; }
  .fin { position: absolute; right: 44px; bottom: 40px; font-family: var(--display); font-weight: 800; font-size: 22px; letter-spacing: 0.28em; color: var(--canvas); user-select: none; pointer-events: none; }

  .site-footer { background: var(--canvas); border-top: 1px solid var(--surface-3); padding: 32px 0 38px; }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 18px 28px; flex-wrap: wrap; }
  .footer-wordmark { font-family: var(--display); font-weight: 700; font-size: 17px; letter-spacing: 0.01em; color: var(--text-1); }
  .footer-links { display: flex; flex-wrap: wrap; gap: 14px 22px; }
  .footer-links a, .footer-copy { font-size: 13px; color: var(--text-2); }
  .footer-links a { font-weight: 500; transition: color 0.15s ease, border-color 0.15s ease; border-bottom: 1px solid transparent; }
  .footer-links a:hover, .footer-links a:focus-visible { color: var(--text-1); border-color: var(--text-1); }

  :focus-visible { outline: 2px solid color-mix(in srgb, var(--accent) 75%, transparent); outline-offset: 3px; }

  @media (max-width: 1024px) {
    .promise-copy { padding-right: 36px; padding-left: 32px; }
    .promise h1 { font-size: clamp(52px, 6.5vw, 76px); }
    .trust-inner { gap: 36px; }
  }

  @media (max-width: 768px) {
    .shell { padding: 0 20px; }
    .promise {
      display: block;
      height: 75svh;
      min-height: 480px;
      max-height: none;
    }
    .promise-visual {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      background: #000000;
    }
    .promise-visual img {
      position: static;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 70% center;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .promise-copy {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: flex-start;
      height: 100%;
      padding: 0 20px 36px;
      background: transparent;
    }
    .promise-copy-inner { width: 100%; }
    .promise h1 { max-width: 10ch; font-size: clamp(44px, 12vw, 60px); }
    .promise-support { max-width: 28ch; margin-top: 18px; font-size: 15px; }
    .promise-actions {
      gap: 12px;
      margin-top: 22px;
    }
    .promise-actions .btn { min-height: 44px; }

    .focus-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .focus-copy { padding: 0; }
    .focus-detail {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--surface-3);
      padding-top: 24px;
    }
    .focus-copy h2, .trust h2 { font-size: clamp(44px, 12vw, 64px); }

    .method { padding: 106px 0 112px; }
    .method h2 { font-size: clamp(44px, 12vw, 62px); }
    .method-sequence { grid-template-columns: 1fr; margin-top: 64px; }
    .method-sequence li, .method-sequence li:first-child { min-height: 0; padding: 22px 0 24px; border-left: 0; border-top: 1px solid var(--surface-3); }
    .method-sequence li:first-child { padding-top: 22px; }
    .method-sequence p { max-width: 30ch; }

    .trust { padding: 106px 0 116px; }
    .trust-inner > p { max-width: 30ch; font-size: 17px; }

    .climax-inner { padding: 96px 20px 84px; }
    .climax p:not(.section-label) { margin-bottom: 28px; }
    .fin { right: 20px; bottom: 20px; font-size: 16px; }
    .footer-links { gap: 12px 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    :global(*) { animation: none !important; transition: none !important; }
  }
</style>
