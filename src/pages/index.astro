---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout title="OurPortfolios — research without the noise">
  <Navbar variant="marketing" />

  <main>
    <section class="hero" aria-label="OurPortfolios introduction">
      <div class="hero-copy">
        <p class="eyebrow">Company research, with a point of view</p>
        <h1>Research without the <em>noise.</em></h1>
        <p class="hero-lede">
          Investing is complex. OurPortfolios keeps the complexity and removes
          what gets in the way of seeing it.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://app.ourportfolios.net">Start exploring</a>
          <a class="btn btn-ghost" href="#framework">See how it works</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 760 620" role="presentation">
          <defs>
            <linearGradient id="ribbon-a" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#60798d" />
              <stop offset="0.48" stop-color="#9fb0bf" />
              <stop offset="1" stop-color="#b0704a" />
            </linearGradient>
            <linearGradient id="ribbon-b" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#2e3742" />
              <stop offset="0.5" stop-color="#8095a5" />
              <stop offset="1" stop-color="#d9a37a" />
            </linearGradient>
            <linearGradient id="ribbon-c" x1="1" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#b0704a" />
              <stop offset="0.5" stop-color="#d9a37a" />
              <stop offset="1" stop-color="#6e8294" />
            </linearGradient>
          </defs>

          <g class="ribbon ribbon-a">
            <path fill="url(#ribbon-a)" d="M-40 118C130 18 270 32 384 112c114 80 190 188 416 74v170c-198 76-304-36-420-118C268 158 140 138-40 270Z" />
          </g>
          <g class="ribbon ribbon-b">
            <path fill="url(#ribbon-b)" d="M-30 346c176-92 282-62 392 22 108 82 194 118 430-32v112c-214 126-344 84-454 4-102-74-190-98-368-4Z" />
          </g>
          <g class="ribbon ribbon-c">
            <path fill="url(#ribbon-c)" d="M128-36c72 174 172 242 294 286 130 46 212 102 266 282H512c-44-106-114-156-218-194C178 294 94 218 40 72Z" />
          </g>
          <path class="ribbon-line" d="M40 184C196 98 304 106 414 174c126 78 192 128 338 58" />
        </svg>
      </div>
    </section>

    <section class="framework" id="framework" aria-label="Interactive framework demonstration">
      <div class="section-intro">
        <p class="eyebrow">Frameworks</p>
        <h2>A framework changes<br /><em>what rises to the surface.</em></h2>
      </div>

      <div class="framework-controls" role="group" aria-label="Choose a framework">
        <button class="framework-option is-active" type="button" data-framework="quality" aria-pressed="true">Quality</button>
        <button class="framework-option" type="button" data-framework="growth" aria-pressed="false">Growth</button>
      </div>

      <div class="demo-wrap">
        <div class="demo-stage" id="framework-demo" style="--split: 50%">
          <div class="demo-label demo-label-left">Full research</div>
          <div class="demo-label demo-label-right" data-focus-label>Quality framework</div>

          <div class="dashboard dashboard-base" aria-hidden="true">
            <div class="dashboard-head"><span>Research</span><span>All signals</span></div>
            <div class="dashboard-grid">
              <div class="panel panel-wide">
                <span class="panel-kicker">Overview</span>
                <div class="shape-line wide"></div>
                <div class="shape-line medium"></div>
                <div class="shape-line short"></div>
              </div>
              <div class="panel panel-tall">
                <span class="panel-kicker">Returns</span>
                <div class="shape-chart"><i></i><i></i><i></i><i></i><i></i></div>
              </div>
              <div class="panel quality">
                <span class="panel-kicker">Margins</span>
                <div class="shape-bar large"></div>
                <div class="shape-bar"></div>
              </div>
              <div class="panel growth">
                <span class="panel-kicker">Growth</span>
                <div class="shape-bar large"></div>
                <div class="shape-bar"></div>
              </div>
              <div class="panel quality">
                <span class="panel-kicker">Efficiency</span>
                <div class="shape-ring"></div>
              </div>
              <div class="panel growth">
                <span class="panel-kicker">Expansion</span>
                <div class="shape-line wide"></div>
                <div class="shape-line short"></div>
              </div>
            </div>
          </div>

          <div class="dashboard dashboard-focus" data-framework="quality" aria-hidden="true">
            <div class="dashboard-head"><span>Research</span><span class="focus-state">Focused</span></div>
            <div class="dashboard-grid">
              <div class="panel panel-wide">
                <span class="panel-kicker">Overview</span>
                <div class="shape-line wide"></div>
                <div class="shape-line medium"></div>
                <div class="shape-line short"></div>
              </div>
              <div class="panel panel-tall">
                <span class="panel-kicker">Returns</span>
                <div class="shape-chart"><i></i><i></i><i></i><i></i><i></i></div>
              </div>
              <div class="panel quality selected">
                <span class="panel-kicker">Margins</span>
                <div class="shape-bar large"></div>
                <div class="shape-bar"></div>
              </div>
              <div class="panel growth muted">
                <span class="panel-kicker">Growth</span>
                <div class="shape-bar large"></div>
                <div class="shape-bar"></div>
              </div>
              <div class="panel quality selected">
                <span class="panel-kicker">Efficiency</span>
                <div class="shape-ring"></div>
              </div>
              <div class="panel growth muted">
                <span class="panel-kicker">Expansion</span>
                <div class="shape-line wide"></div>
                <div class="shape-line short"></div>
              </div>
            </div>
          </div>

          <div class="split-handle" id="split-handle" role="slider" aria-label="Compare full research with framework view" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
            <span></span>
          </div>
        </div>
        <p class="demo-hint">Drag the divider to compare</p>
      </div>
    </section>

    <section class="climax" aria-label="Start exploring">
      <div class="climax-inner">
        <h2>Roll credits on guesswork.</h2>
        <p>
          Every number explained, every chart annotated, every claim sourced.
          The methodology is open-source, on the record, and free to check.
        </p>
        <a class="btn btn-invert" href="https://app.ourportfolios.net">Start exploring</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-wordmark">OurPortfolios</span>
      <nav aria-label="Footer">
        <a href="https://app.ourportfolios.net/tickers">Markets</a>
        <a href="https://app.ourportfolios.net/industry">Analysis</a>
        <a href="https://app.ourportfolios.net/framework">Method</a>
      </nav>
      <span class="footer-copy">2026 OurPortfolios</span>
    </div>
  </footer>
</BaseLayout>

<script>
  const demo = document.querySelector<HTMLElement>("#framework-demo");
  const handle = document.querySelector<HTMLElement>("#split-handle");
  const focusLayer = document.querySelector<HTMLElement>(".dashboard-focus");
  const focusLabel = document.querySelector<HTMLElement>("[data-focus-label]");
  const options = document.querySelectorAll<HTMLButtonElement>(".framework-option");

  if (demo && handle && focusLayer) {
    let dragging = false;

    const setSplit = (value: number) => {
      const split = Math.min(88, Math.max(12, value));
      demo.style.setProperty("--split", `${split}%`);
      handle.style.left = `${split}%`;
      handle.setAttribute("aria-valuenow", String(Math.round(split)));
    };

    const setFramework = (framework: string) => {
      focusLayer.dataset.framework = framework;
      if (focusLabel) focusLabel.textContent = `${framework === "growth" ? "Growth" : "Quality"} framework`;
      options.forEach((option) => {
        const active = option.dataset.framework === framework;
        option.classList.toggle("is-active", active);
        option.setAttribute("aria-pressed", String(active));
      });
    };

    const pointerToSplit = (clientX: number) => {
      const rect = demo.getBoundingClientRect();
      setSplit(((clientX - rect.left) / rect.width) * 100);
    };

    handle.addEventListener("pointerdown", (event) => {
      dragging = true;
      handle.setPointerCapture(event.pointerId);
      handle.classList.add("is-dragging");
    });

    handle.addEventListener("pointermove", (event) => {
      if (dragging) pointerToSplit(event.clientX);
    });

    handle.addEventListener("pointerup", () => {
      dragging = false;
      handle.classList.remove("is-dragging");
    });

    handle.addEventListener("pointercancel", () => {
      dragging = false;
      handle.classList.remove("is-dragging");
    });

    handle.addEventListener("keydown", (event) => {
      const current = Number(handle.getAttribute("aria-valuenow") || 50);
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setSplit(current - 5);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        setSplit(current + 5);
      }
    });

    options.forEach((option) => {
      option.addEventListener("click", () => setFramework(option.dataset.framework || "quality"));
    });

    setSplit(50);
    setFramework("quality");
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  h1, h2, p { margin: 0; }

  .hero {
    position: relative;
    min-height: calc(100svh - 64px);
    max-width: 1320px;
    margin: 0 auto;
    padding: 70px 48px 90px;
    display: grid;
    grid-template-columns: minmax(390px, .82fr) minmax(520px, 1.18fr);
    align-items: center;
    gap: 30px;
    overflow: hidden;
  }

  .hero-copy { position: relative; z-index: 2; max-width: 610px; }
  .eyebrow {
    margin-bottom: 24px;
    color: var(--text-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 680px;
    font-family: var(--display);
    font-size: clamp(64px, 7vw, 104px);
    line-height: .9;
    letter-spacing: -.055em;
    font-weight: 700;
    text-wrap: balance;
  }
  h1 em, .framework h2 em { color: var(--accent-warm); font-style: normal; }
  .hero-lede {
    max-width: 450px;
    margin-top: 34px;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.65;
  }
  .hero-actions { display: flex; gap: 10px; margin-top: 38px; }

  .hero-art {
    position: relative;
    min-height: 620px;
    display: grid;
    place-items: center;
  }
  .hero-art svg {
    width: 118%;
    height: auto;
    overflow: visible;
    transform: rotate(-4deg) translate(3%, 1%);
  }
  .ribbon { transform-origin: 50% 50%; }
  .ribbon-line {
    fill: none;
    stroke: color-mix(in srgb, var(--text-1) 34%, transparent);
    stroke-width: 2;
  }

  .framework {
    max-width: 1240px;
    margin: 0 auto;
    padding: 150px 48px 170px;
  }
  .section-intro { max-width: 760px; }
  .framework h2 {
    font-family: var(--display);
    font-size: clamp(48px, 5.3vw, 76px);
    line-height: .92;
    letter-spacing: -.05em;
    font-weight: 700;
  }

  .framework-controls {
    display: flex;
    gap: 6px;
    margin-top: 48px;
  }
  .framework-option {
    appearance: none;
    border: 1px solid var(--hairline);
    background: transparent;
    color: var(--text-2);
    border-radius: 999px;
    padding: 10px 17px;
    font: 600 12px/1 var(--sans);
    cursor: pointer;
    transition: color .25s ease, background-color .25s ease, border-color .25s ease;
  }
  .framework-option:hover { color: var(--text-1); border-color: color-mix(in srgb, var(--text-1) 25%, transparent); }
  .framework-option.is-active {
    color: var(--canvas);
    background: var(--text-1);
    border-color: var(--text-1);
  }

  .demo-wrap { margin-top: 20px; }
  .demo-stage {
    position: relative;
    min-height: 610px;
    overflow: hidden;
    border-radius: 22px;
    background: var(--surface-1);
    border: 1px solid var(--hairline);
    user-select: none;
  }
  .dashboard {
    position: absolute;
    inset: 0;
    padding: 34px;
  }
  .dashboard-focus {
    clip-path: inset(0 0 0 var(--split));
    background: var(--surface-1);
    pointer-events: none;
  }
  .dashboard-head {
    display: flex;
    justify-content: space-between;
    color: var(--text-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .focus-state { color: var(--accent-warm); }
  .dashboard-grid {
    display: grid;
    grid-template-columns: 1.35fr .65fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
    margin-top: 28px;
    height: 500px;
  }
  .panel {
    position: relative;
    overflow: hidden;
    min-width: 0;
    border-radius: 14px;
    background: var(--surface-2);
    padding: 22px;
    transition: opacity .35s ease, background-color .35s ease, transform .35s ease;
  }
  .panel-wide { grid-column: span 2; }
  .panel-tall { grid-row: span 2; }
  .panel-kicker {
    display: block;
    color: color-mix(in srgb, var(--text-2) 68%, transparent);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .shape-line, .shape-bar {
    height: 9px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--text-2) 16%, transparent);
  }
  .shape-line { margin-top: 22px; }
  .shape-line + .shape-line { margin-top: 10px; }
  .shape-line.wide { width: 76%; }
  .shape-line.medium { width: 54%; }
  .shape-line.short { width: 32%; }
  .shape-bar { width: 54%; margin-top: 32px; }
  .shape-bar.large { width: 78%; height: 16px; background: color-mix(in srgb, var(--text-2) 23%, transparent); }
  .shape-bar + .shape-bar { margin-top: 10px; }
  .shape-chart {
    position: absolute;
    inset: 80px 24px 28px;
    display: flex;
    align-items: flex-end;
    gap: 9px;
  }
  .shape-chart i {
    flex: 1;
    height: 30%;
    border-radius: 5px 5px 0 0;
    background: color-mix(in srgb, var(--text-2) 15%, transparent);
  }
  .shape-chart i:nth-child(2) { height: 48%; }
  .shape-chart i:nth-child(3) { height: 39%; }
  .shape-chart i:nth-child(4) { height: 68%; }
  .shape-chart i:nth-child(5) { height: 82%; }
  .shape-ring {
    width: 105px;
    aspect-ratio: 1;
    margin-top: 38px;
    border: 14px solid color-mix(in srgb, var(--text-2) 13%, transparent);
    border-right-color: color-mix(in srgb, var(--text-2) 26%, transparent);
    border-radius: 50%;
  }

  .dashboard-focus .panel.quality.selected,
  .dashboard-focus .panel.growth.selected {
    background: color-mix(in srgb, var(--accent-warm) 13%, var(--surface-2));
  }
  .dashboard-focus .panel.quality.selected .shape-bar.large,
  .dashboard-focus .panel.quality.selected .shape-ring,
  .dashboard-focus .panel.growth.selected .shape-bar.large,
  .dashboard-focus .panel.growth.selected .shape-ring {
    background-color: color-mix(in srgb, var(--accent-warm) 64%, var(--surface-2));
    border-color: color-mix(in srgb, var(--accent-warm) 64%, var(--surface-2));
  }
  .dashboard-focus .panel.muted { opacity: .22; }
  .dashboard-focus[data-framework="growth"] .panel.quality.selected { opacity: .22; }
  .dashboard-focus[data-framework="growth"] .panel.growth.muted { opacity: 1; }
  .dashboard-focus[data-framework="growth"] .panel.growth.muted { background: color-mix(in srgb, var(--accent-warm) 13%, var(--surface-2)); }
  .dashboard-focus[data-framework="growth"] .panel.growth.muted .shape-bar.large { background: color-mix(in srgb, var(--accent-warm) 64%, var(--surface-2)); }
  .dashboard-focus[data-framework="growth"] .panel.quality.selected { background: var(--surface-2); }

  .demo-label {
    position: absolute;
    z-index: 5;
    top: 31px;
    padding: 7px 11px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--canvas) 78%, transparent);
    color: var(--text-1);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .07em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }
  .demo-label-left { left: 30px; }
  .demo-label-right { right: 30px; color: var(--accent-warm); }

  .split-handle {
    position: absolute;
    z-index: 10;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    transform: translateX(-50%);
    background: var(--text-1);
    cursor: ew-resize;
    touch-action: none;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--canvas) 25%, transparent);
  }
  .split-handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 42px;
    height: 42px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--text-1);
    box-shadow: 0 8px 30px color-mix(in srgb, #000 30%, transparent);
  }
  .split-handle span::before,
  .split-handle span::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-top: 2px solid var(--canvas);
    border-left: 2px solid var(--canvas);
  }
  .split-handle span::before { left: 12px; transform: translateY(-50%) rotate(-45deg); }
  .split-handle span::after { right: 12px; transform: translateY(-50%) rotate(135deg); }
  .split-handle.is-dragging span { transform: translate(-50%, -50%) scale(1.08); }
  .demo-hint { margin-top: 14px; color: var(--text-2); font-size: 12px; text-align: center; }

  .climax { background: var(--gradient); }
  .climax-inner { max-width: 1180px; margin: 0 auto; padding: 150px 48px 120px; }
  .climax h2 { max-width: 620px; font-family: var(--display); font-size: clamp(48px, 6vw, 80px); line-height: .95; letter-spacing: -.045em; font-weight: 700; }
  .climax p { max-width: 510px; margin-top: 26px; color: color-mix(in srgb, var(--text-1) 82%, transparent); font-size: 16px; line-height: 1.65; }
  .climax .btn { margin-top: 38px; }

  .site-footer { border-top: 1px solid var(--hairline); }
  .footer-inner { max-width: 1180px; margin: 0 auto; padding: 30px 48px; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
  .footer-wordmark { font-family: var(--display); font-size: 16px; font-weight: 700; }
  .footer-inner nav { display: flex; gap: 26px; }
  .footer-inner nav a, .footer-copy { color: var(--text-2); font-size: 11px; }
  .footer-inner nav a:hover { color: var(--text-1); }

  @media (prefers-reduced-motion: no-preference) {
    .ribbon-a { animation: ribbon-a 12s ease-in-out infinite alternate; }
    .ribbon-b { animation: ribbon-b 15s ease-in-out infinite alternate; }
    .ribbon-c { animation: ribbon-c 17s ease-in-out infinite alternate; }
    .ribbon-line { animation: ribbon-line 11s ease-in-out infinite alternate; }
    @keyframes ribbon-a { to { transform: translate(-10px, 12px) rotate(1deg); } }
    @keyframes ribbon-b { to { transform: translate(8px, -9px) rotate(-1deg); } }
    @keyframes ribbon-c { to { transform: translate(5px, 8px) rotate(2deg); } }
    @keyframes ribbon-line { to { transform: translate(4px, -6px); opacity: .58; } }
  }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; padding-top: 70px; }
    .hero-art { min-height: 430px; margin-top: -20px; }
    .hero-art svg { width: 105%; }
    .framework { padding-top: 110px; }
    .demo-stage { min-height: 520px; }
    .dashboard-grid { height: 410px; }
  }

  @media (max-width: 680px) {
    .hero { padding: 58px 22px 70px; }
    .hero-art { min-height: 300px; }
    .hero-art svg { width: 125%; }
    .hero-actions { flex-wrap: wrap; }
    .framework { padding: 90px 22px 110px; }
    .framework-controls { margin-top: 34px; }
    .demo-stage { min-height: 500px; border-radius: 16px; }
    .dashboard { padding: 22px; }
    .dashboard-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr 1fr; height: 425px; gap: 9px; margin-top: 22px; }
    .panel-wide { grid-column: span 2; }
    .panel-tall { grid-row: span 1; }
    .panel { padding: 15px; border-radius: 10px; }
    .demo-label { top: 20px; font-size: 9px; }
    .demo-label-left { left: 18px; }
    .demo-label-right { right: 18px; }
    .split-handle span { width: 36px; height: 36px; }
    .climax-inner { padding: 100px 22px 90px; }
    .footer-inner { padding: 26px 22px; flex-wrap: wrap; }
    .footer-inner nav { order: 3; width: 100%; }
  }
</style>
