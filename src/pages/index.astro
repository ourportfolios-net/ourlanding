---
// Route / — OurPortfolios' media-led point of view for individual investors.
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout title="OurPortfolios — Complexity without the noise">
  <!--
    THESIS: Complexity becomes useful when a point of view changes what leads, not what remains.
    OWN-WORLD: Steel Copper, Cabinet Grotesk and General Sans move through bronze, charcoal, paper, copper, grayscale and quiet neutral media.
    STORY: A retail investor feels the cost of equal visual weight, sees an ordered method, and starts exploring without surrendering judgment.
    FIRST VIEWPORT: The required thesis sits in a dark left rail beside a large bronze ribbon field; the nav remains the only immediate route.
    FORM: A material sequence of full-scale local stills and one atmospheric loop, replacing the dashboard-led landing-page default.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
  -->
  <Navbar variant="marketing" />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Complexity <em>without the noise.</em></h1>
        <p>Keep the full picture. Change what comes forward.</p>
        <span class="hero-support">For individual investors who want more than another dashboard.</span>
      </div>
      <figure class="hero-media">
        <img
          src="/assets/landing/hero/bronze-ribbons-1600.webp"
          srcset="/assets/landing/hero/bronze-ribbons-1600.webp 1600w, /assets/landing/hero/bronze-ribbons-2400.webp 2400w"
          sizes="(min-width: 801px) 62vw, 100vw"
          alt="Curved bronze ribbons crossing a layered geometric field"
          width="1600"
          height="1067"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="density" aria-labelledby="density-title">
      <div class="shell density-intro">
        <h2 id="density-title">When everything competes, nothing leads.</h2>
        <p>Other dashboards create noise when every metric is given the same visual weight.</p>
      </div>
      <figure class="density-wide">
        <img
          src="/assets/landing/density/dark-rectangles-1600.webp"
          srcset="/assets/landing/density/dark-rectangles-1600.webp 1600w, /assets/landing/density/dark-rectangles-2400.webp 2400w"
          sizes="(min-width: 801px) 520px, calc(100vw - 40px)"
          alt="Overlapping dark rectangular planes arranged in a dense field"
          width="1067"
          height="1600"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="shell density-continuation">
        <figure class="density-folds">
          <img
            src="/assets/landing/density/dark-folds-1600.webp"
            srcset="/assets/landing/density/dark-folds-1600.webp 1600w, /assets/landing/density/dark-folds-2400.webp 2400w"
            sizes="(min-width: 801px) 520px, 82vw"
            alt="Dark folded forms falling through shifting shadows"
            width="1600"
            height="1067"
            loading="lazy"
            decoding="async"
          />
          <figcaption>More information is not the same as more orientation.</figcaption>
        </figure>
      </div>
    </section>

    <section class="mechanism" aria-labelledby="mechanism-title">
      <div class="shell mechanism-grid">
        <figure class="mechanism-media">
          <img
            src="/assets/landing/mechanism/curved-paper-1600.webp"
            srcset="/assets/landing/mechanism/curved-paper-1600.webp 1600w, /assets/landing/mechanism/curved-paper-2400.webp 2400w"
            sizes="(min-width: 801px) 56vw, 100vw"
            alt="White paper sheets curving in sequence across a pale field"
            width="1600"
            height="1067"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="mechanism-copy">
          <h2 id="mechanism-title">A framework organizes questions and metrics around a point of view. What comes forward changes while the full picture remains.</h2>
          <div class="question-list">
            <p>Start with the question.</p>
            <p>Put the metric in context.</p>
            <p>Keep the uncertainty visible.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="foreground" aria-labelledby="foreground-title">
      <div class="foreground-media-wrap">
        <figure class="foreground-media">
          <img
            src="/assets/landing/focus/copper-wall-1600.webp"
            srcset="/assets/landing/focus/copper-wall-1600.webp 1600w, /assets/landing/focus/copper-wall-2400.webp 2400w"
            sizes="(min-width: 801px) 680px, 100vw"
            alt="A curved copper wall with striped shadows cast across the ground"
            width="1067"
            height="1600"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
      <div class="shell foreground-copy">
        <h2 id="foreground-title">Keep the full picture.<br />Change what comes forward.</h2>
        <p>The context stays. Your next question becomes easier to see.</p>
      </div>
    </section>

    <section class="motion-method" aria-labelledby="motion-title">
      <div class="shell motion-stage">
        <div class="motion-media">
          <video
            class="method-video"
            autoplay
            muted
            loop
            playsinline
            poster="/assets/landing/method/grayscale-fabric-loop-poster.webp"
            preload="metadata"
            aria-label="Slow grayscale fabric moving through light and shadow"
          >
            <source src="/assets/landing/method/grayscale-fabric-loop.mp4" type="video/mp4" />
            <img
              src="/assets/landing/method/grayscale-fabric-loop-poster.webp"
              srcset="/assets/landing/method/grayscale-fabric-loop-poster.webp 1280w"
              sizes="(min-width: 801px) 60vw, 100vw"
              alt="Grayscale fabric folded into slow waves of light and shadow"
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </video>
          <img
            class="motion-poster"
            src="/assets/landing/method/grayscale-fabric-loop-poster.webp"
            srcset="/assets/landing/method/grayscale-fabric-loop-poster.webp 1280w"
            sizes="(min-width: 801px) 60vw, 100vw"
            alt="Grayscale fabric folded into slow waves of light and shadow"
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="motion-copy">
          <h2 id="motion-title">A useful method keeps the work of deciding visible.</h2>
          <div class="method-beats" aria-label="Method cadence">
            <span>Ask.</span>
            <span>Compare.</span>
            <span>Reconsider.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="steps" aria-labelledby="steps-title">
      <div class="shell steps-grid">
        <figure class="steps-media">
          <img
            src="/assets/landing/method/white-steps-1600.webp"
            srcset="/assets/landing/method/white-steps-1600.webp 1600w, /assets/landing/method/white-steps-2400.webp 2400w"
            sizes="(min-width: 801px) 68vw, 100vw"
            alt="White steps spiraling upward in a sculptural sequence"
            width="1600"
            height="1067"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="steps-copy">
          <h2 id="steps-title">Make the judgment.</h2>
          <div class="step-beats">
            <p>See the question.</p>
            <p>Read the context.</p>
            <p>Make the judgment.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="philosophy" aria-labelledby="philosophy-title">
      <figure class="philosophy-primary">
        <img
          src="/assets/landing/philosophy/neutral-layers-1600.webp"
          srcset="/assets/landing/philosophy/neutral-layers-1600.webp 1600w, /assets/landing/philosophy/neutral-layers-2400.webp 2400w"
          sizes="calc(100vw - 64px)"
          alt="Undulating neutral layers creating a wide, quiet horizon"
          width="1600"
          height="1067"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="shell philosophy-copy">
        <h2 id="philosophy-title">Clarity is a practice.</h2>
        <p>Method before verdict. Context stays attached. Your judgment remains yours.</p>
      </div>
      <div class="philosophy-transitions" aria-label="A sequence from one leading curve into open space">
        <figure class="philosophy-transition transition-curves">
          <img
            src="/assets/landing/philosophy/neutral-curves-1600.webp"
            srcset="/assets/landing/philosophy/neutral-curves-1600.webp 1600w, /assets/landing/philosophy/neutral-curves-2400.webp 2400w"
            sizes="100vw"
            alt="A single neutral curve crossing a softly lit field"
            width="1600"
            height="1067"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="philosophy-transition transition-white">
          <img
            src="/assets/landing/philosophy/soft-white-curves-1600.webp"
            srcset="/assets/landing/philosophy/soft-white-curves-1600.webp 1600w, /assets/landing/philosophy/soft-white-curves-2400.webp 2400w"
            sizes="100vw"
            alt="Soft white curved forms opening into negative space"
            width="1067"
            height="1600"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <!-- pre-footer climax CTA · the one full gradient; visual implementation preserved -->
    <section class="climax" aria-label="Make room for the right questions.">
      <div class="climax-inner">
        <h2>Make room for the right questions.</h2>
        <p>Keep the full picture. Change what comes forward.</p>
        <a class="btn btn-invert" href="https://app.ourportfolios.net">Start exploring</a>
      </div>
      <span class="fin" aria-hidden="true">OP</span>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <span class="footer-wordmark">OurPortfolios</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://app.ourportfolios.net/framework">Method</a>
        <a href="/contacts">Contact</a>
      </nav>
      <span class="footer-copy">2025 OurPortfolios</span>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .shell {
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 0 32px;
  }

  h1,
  h2,
  p,
  figure {
    margin: 0;
  }

  h1,
  h2 {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.25fr);
    min-height: calc(100vh - 64px);
    background: var(--canvas);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 96px clamp(28px, 5vw, 72px) 96px max(32px, calc((100vw - 1120px) / 2));
  }

  .hero h1 {
    max-width: 580px;
    font-size: clamp(58px, 7.2vw, 96px);
  }

  .hero h1 em {
    display: block;
    color: var(--accent-warm);
    font-style: normal;
  }

  .hero-copy > p {
    max-width: 16ch;
    margin-top: 42px;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.1;
    color: var(--text-1);
  }

  .hero-support {
    max-width: 34ch;
    margin-top: 28px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-2);
  }

  .hero-media {
    min-height: 600px;
    overflow: hidden;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  .density {
    padding: 150px 0 168px;
    background: var(--surface-1);
  }

  .density-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr);
    gap: clamp(48px, 9vw, 140px);
    align-items: end;
    padding-bottom: 72px;
  }

  .density h2 {
    max-width: 660px;
    font-size: clamp(48px, 6.3vw, 82px);
  }

  .density-intro > p {
    max-width: 34ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .density-wide {
    width: min(520px, calc(100% - 64px));
    aspect-ratio: 2 / 3;
    margin: 0 max(32px, calc((100vw - 1120px) / 2));
    overflow: hidden;
  }

  .density-wide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
  }

  .density-continuation {
    display: flex;
    justify-content: flex-end;
    margin-top: 42px;
  }

  .density-folds {
    width: min(520px, 48%);
  }

  .density-folds img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 54% center;
  }

  figcaption {
    margin-top: 14px;
    font-size: 12px;
    line-height: 1.4;
    color: var(--text-2);
  }

  .mechanism {
    padding: 160px 0;
    background: #f0eee9;
    color: #202326;
  }

  .mechanism-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(52px, 9vw, 132px);
    align-items: center;
  }

  .mechanism-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .mechanism-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 44% center;
  }

  .mechanism h2 {
    max-width: 460px;
    font-size: clamp(38px, 4vw, 58px);
    color: #202326;
  }

  .question-list {
    display: grid;
    gap: 22px;
    margin-top: 48px;
  }

  .question-list p {
    max-width: 19ch;
    font-family: var(--display);
    font-size: clamp(20px, 2vw, 27px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #202326;
  }

  .foreground {
    padding: 160px 0 154px;
    background: var(--canvas);
  }

  .foreground-media-wrap {
    width: min(1120px, calc(100% - 64px));
    margin: 0 auto;
  }

  .foreground-media {
    width: min(62%, 680px);
    margin-left: auto;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .foreground-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .foreground-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.4fr);
    gap: 56px;
    align-items: end;
    margin-top: -120px;
    position: relative;
  }

  .foreground h2 {
    max-width: 700px;
    font-size: clamp(48px, 6.5vw, 84px);
  }

  .foreground-copy > p {
    max-width: 25ch;
    padding-bottom: 4px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .motion-method {
    padding: 142px 0 156px;
    background: var(--surface-2);
  }

  .motion-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(250px, 0.8fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: end;
  }

  .motion-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #272b2e;
  }

  .method-video,
  .motion-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .motion-poster {
    display: none;
  }

  .motion-copy h2 {
    max-width: 360px;
    font-size: clamp(36px, 4vw, 56px);
  }

  .method-beats,
  .step-beats {
    display: grid;
    gap: 12px;
    margin-top: 42px;
  }

  .method-beats span,
  .step-beats p {
    font-family: var(--display);
    font-size: clamp(22px, 2.5vw, 34px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .method-beats span:nth-child(2) {
    color: var(--accent-cool);
  }

  .method-beats span:nth-child(3) {
    color: var(--accent-warm);
  }

  .steps {
    padding: 158px 0 170px;
    background: #eceae5;
    color: #202326;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.65fr);
    gap: clamp(52px, 9vw, 134px);
    align-items: center;
  }

  .steps-media {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .steps-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .steps h2 {
    font-size: clamp(42px, 5vw, 68px);
    color: #202326;
  }

  .step-beats p {
    color: #202326;
  }

  .step-beats p + p {
    color: #6b4938;
  }

  .philosophy {
    padding: 152px 0 0;
    background: var(--canvas);
  }

  .philosophy-primary {
    width: min(1360px, calc(100% - 64px));
    height: min(40vw, 540px);
    min-height: 300px;
    margin: 0 auto;
    overflow: hidden;
  }

  .philosophy-primary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
  }

  .philosophy-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr);
    gap: clamp(48px, 9vw, 140px);
    align-items: end;
    padding-top: 92px;
    padding-bottom: 120px;
  }

  .philosophy h2 {
    max-width: 560px;
    font-size: clamp(48px, 6vw, 78px);
  }

  .philosophy-copy p {
    max-width: 31ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .philosophy-transitions {
    display: flex;
    align-items: stretch;
    gap: 0;
    width: 100%;
    margin: 0;
    padding-bottom: 156px;
  }

  .philosophy-transition {
    flex: 1.45 1 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .philosophy-transition img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .transition-curves img {
    object-position: 58% center;
  }

  .transition-white {
    flex: 0.7 1 0;
    aspect-ratio: 2 / 3;
    align-self: stretch;
  }

  .transition-white img {
    object-position: center 42%;
  }

  /* pre-footer climax · the one full gradient */

  .climax {
    position: relative;
    overflow: hidden;
    background: var(--gradient);
  }

  .climax-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 150px 32px 120px;
  }

  .climax h2 {
    max-width: 620px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(38px, 6vw, 72px);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text-1);
    text-wrap: balance;
    margin-bottom: 22px;
  }

  .climax p {
    max-width: 540px;
    font-size: 16.5px;
    line-height: 1.65;
    color: color-mix(in srgb, var(--text-1) 80%, transparent);
    margin-bottom: 36px;
  }

  .fin {
    position: absolute;
    right: 44px;
    bottom: 40px;
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.28em;
    color: var(--canvas);
    user-select: none;
    pointer-events: none;
  }

  .site-footer {
    background: var(--canvas);
    border-top: 1px solid var(--surface-3);
    padding: 32px 0 38px;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px 28px;
    flex-wrap: wrap;
  }

  .footer-wordmark {
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.01em;
    color: var(--text-1);
  }

  .footer-links {
    display: flex;
    gap: 22px;
  }

  .footer-links a,
  .footer-copy {
    font-size: 13px;
    color: var(--text-2);
  }

  .footer-links a {
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--text-1);
  }

  :focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 75%, transparent);
    outline-offset: 2px;
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      min-height: 540px;
      padding: 88px 32px 70px;
    }

    .hero-media {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .density-intro,
    .mechanism-grid,
    .foreground-copy,
    .motion-stage,
    .steps-grid,
    .philosophy-copy {
      grid-template-columns: 1fr;
    }

    .density-intro {
      gap: 28px;
    }

    .density-wide,
    .philosophy-primary,
    .foreground-media-wrap {
      width: calc(100% - 40px);
    }

    .density-folds {
      width: min(520px, 72%);
    }

    .mechanism-media {
      aspect-ratio: 4 / 3;
    }

    .foreground-media {
      width: min(72%, 560px);
    }

    .foreground-copy {
      margin-top: 44px;
      gap: 28px;
    }

    .motion-copy {
      max-width: 520px;
    }

    .steps-media {
      width: min(72%, 560px);
    }

    .philosophy-copy {
      gap: 28px;
    }
  }

  @media (max-width: 640px) {
    .shell {
      padding: 0 20px;
    }

    .hero-copy {
      min-height: 0;
      padding: 76px 20px 62px;
    }

    .hero h1 {
      font-size: clamp(52px, 14vw, 76px);
    }

    .hero-copy > p {
      margin-top: 32px;
      font-size: 24px;
    }

    .hero-media {
      aspect-ratio: 4 / 3;
    }

    .density,
    .mechanism,
    .foreground,
    .motion-method,
    .steps {
      padding-top: 100px;
      padding-bottom: 108px;
    }

    .density-intro {
      padding-bottom: 48px;
    }

    .density-wide,
    .philosophy-primary,
    .foreground-media-wrap {
      width: calc(100% - 40px);
    }

    .density-wide {
      aspect-ratio: 2 / 3;
      margin-left: 20px;
      margin-right: 20px;
    }

    .density-continuation {
      margin-top: 34px;
    }

    .density-folds {
      width: 82%;
    }

