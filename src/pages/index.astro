---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout title="OurPortfolios — research without the noise">
  <Navbar variant="marketing" />

  <main>
    <section class="hero" aria-label="OurPortfolios introduction">
      <div class="hero-copy">
        <p class="eyebrow">Company research, with a point of view</p>
        <h1>Research without the <em>noise.</em></h1>
        <p class="hero-lede">
          Investing is complex. OurPortfolios keeps the complexity and removes
          what gets in the way of seeing it.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://app.ourportfolios.net">Start exploring</a>
          <a class="btn btn-ghost" href="#framework">See how it works</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="orb orb-one"></div>
        <div class="orb orb-two"></div>
        <div class="orb orb-three"></div>
        <div class="art-ring ring-one"></div>
        <div class="art-ring ring-two"></div>
        <div class="art-core"></div>
      </div>
    </section>

    <section class="framework" id="framework" aria-label="Framework demonstration">
      <div class="framework-heading">
        <p class="eyebrow">Frameworks</p>
        <h2>Change the lens.<br /><em>Find what matters.</em></h2>
      </div>

      <div class="demo">
        <div class="research-surface">
          <div class="surface-top">
            <span>Company research</span>
            <span class="surface-state">Full view</span>
          </div>
          <div class="signal-field full-view">
            <div class="signal signal-a"><i></i><i></i><i></i><i></i></div>
            <div class="signal signal-b"><i></i><i></i><i></i></div>
            <div class="signal signal-c"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="signal signal-d"><i></i><i></i></div>
            <div class="signal signal-e"><i></i><i></i><i></i></div>
          </div>
        </div>

        <div class="lens">
          <div class="lens-top">
            <span>Framework</span>
            <span>Applied</span>
          </div>
          <div class="lens-name">A point of view</div>
          <div class="lens-bars">
            <span></span><span></span><span></span>
          </div>
          <div class="lens-copy">The same research, with attention directed where it belongs.</div>
        </div>

        <div class="research-surface focused">
          <div class="surface-top">
            <span>Company research</span>
            <span class="surface-state active">Focused</span>
          </div>
          <div class="signal-field">
            <div class="signal signal-a selected"><i></i><i></i><i></i><i></i></div>
            <div class="signal signal-b faded"><i></i><i></i><i></i></div>
            <div class="signal signal-c selected"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="signal signal-d faded"><i></i><i></i></div>
            <div class="signal signal-e faded"><i></i><i></i><i></i></div>
          </div>
        </div>
      </div>
    </section>

    <section class="principle" aria-label="OurPortfolios principle">
      <p>Complexity belongs in the research.<br /><span>Not between you and the insight.</span></p>
    </section>

    <section class="climax" aria-label="Start exploring">
      <div class="climax-inner">
        <h2>Roll credits on guesswork.</h2>
        <p>
          Every number explained, every chart annotated, every claim sourced.
          The methodology is open-source, on the record, and free to check.
        </p>
        <a class="btn btn-invert" href="https://app.ourportfolios.net">Start exploring</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-wordmark">OurPortfolios</span>
      <nav aria-label="Footer">
        <a href="https://app.ourportfolios.net/tickers">Markets</a>
        <a href="https://app.ourportfolios.net/industry">Analysis</a>
        <a href="https://app.ourportfolios.net/framework">Method</a>
      </nav>
      <span class="footer-copy">2026 OurPortfolios</span>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; }
  h1, h2, p { margin: 0; }

  .hero {
    position: relative;
    min-height: calc(100svh - 64px);
    max-width: 1320px;
    margin: 0 auto;
    padding: 70px 48px 90px;
    display: grid;
    grid-template-columns: minmax(400px, .82fr) minmax(520px, 1.18fr);
    align-items: center;
    gap: 40px;
    overflow: hidden;
  }

  .hero-copy { position: relative; z-index: 2; max-width: 590px; }
  .eyebrow {
    margin-bottom: 24px;
    color: var(--text-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 680px;
    font-family: var(--display);
    font-size: clamp(64px, 7vw, 104px);
    line-height: .9;
    letter-spacing: -.055em;
    font-weight: 700;
    text-wrap: balance;
  }
  h1 em, .framework h2 em { color: var(--accent-warm); font-style: normal; }
  .hero-lede {
    max-width: 450px;
    margin-top: 34px;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.65;
  }
  .hero-actions { display: flex; gap: 10px; margin-top: 38px; }

  /* A single large, abstract hero object. No company, ticker, numbers or fake UI. */
  .hero-art {
    position: relative;
    min-height: 620px;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .hero-art::before {
    content: "";
    position: absolute;
    width: 82%;
    height: 70%;
    border-radius: 50%;
    background: radial-gradient(ellipse at 42% 48%, color-mix(in srgb, var(--accent-warm) 34%, transparent), transparent 58%);
    filter: blur(30px);
    opacity: .75;
    z-index: -2;
  }
  .orb {
    position: absolute;
    border-radius: 48% 52% 58% 42% / 42% 46% 54% 58%;
    filter: saturate(.95);
    mix-blend-mode: screen;
    will-change: transform;
  }
  .orb-one {
    width: 58%; height: 67%;
    background: linear-gradient(145deg, var(--accent-deep), var(--accent-2) 48%, var(--accent-warm));
    transform: rotate(-18deg) translate(-7%, 2%);
  }
  .orb-two {
    width: 46%; height: 72%;
    background: linear-gradient(155deg, color-mix(in srgb, var(--accent-warm) 82%, white), var(--accent) 54%, var(--accent-deep));
    transform: rotate(27deg) translate(17%, -1%);
    opacity: .82;
  }
  .orb-three {
    width: 31%; height: 52%;
    background: linear-gradient(160deg, var(--accent-warm), var(--accent-deep));
    transform: rotate(-34deg) translate(27%, 11%);
    opacity: .72;
  }
  .art-ring {
    position: absolute;
    border: 2px solid color-mix(in srgb, var(--accent-warm) 48%, transparent);
    border-radius: 50%;
    transform: rotate(-20deg) scaleX(1.25);
    pointer-events: none;
  }
  .ring-one { width: 75%; height: 47%; }
  .ring-two { width: 57%; height: 77%; transform: rotate(31deg) scaleX(1.1); border-color: color-mix(in srgb, var(--text-1) 13%, transparent); }
  .art-core {
    width: 24%; aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--accent-warm), var(--accent-deep) 70%);
    box-shadow: 0 0 80px color-mix(in srgb, var(--accent-warm) 26%, transparent);
  }

  .framework { max-width: 1180px; margin: 0 auto; padding: 150px 48px 150px; }
  .framework-heading { max-width: 650px; margin-bottom: 70px; }
  .framework h2 {
    font-family: var(--display);
    font-size: clamp(48px, 5.3vw, 74px);
    line-height: .92;
    letter-spacing: -.05em;
    font-weight: 700;
  }

  .demo { display: grid; grid-template-columns: 1fr 210px 1fr; align-items: center; gap: 20px; }
  .research-surface, .lens {
    background: var(--surface-1);
    border-radius: 16px;
    box-shadow: 0 24px 70px color-mix(in srgb, #000 24%, transparent);
  }
  .research-surface { padding: 22px; }
  .surface-top, .lens-top { display: flex; justify-content: space-between; align-items: center; color: var(--text-2); font-size: 10px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; }
  .surface-state.active { color: var(--accent-warm); }
  .signal-field { min-height: 280px; margin-top: 24px; padding: 24px; border-radius: 10px; background: var(--surface-2); display: flex; flex-direction: column; justify-content: center; gap: 17px; }
  .signal { display: flex; gap: 7px; height: 20px; align-items: center; }
  .signal i { display: block; height: 100%; flex: 1; border-radius: 4px; background: color-mix(in srgb, var(--text-2) 18%, transparent); }
  .signal i:nth-child(2) { opacity: .7; }.signal i:nth-child(3) { opacity: .45; }.signal i:nth-child(4) { opacity: .28; }.signal i:nth-child(5) { opacity: .18; }
  .selected i { background: color-mix(in srgb, var(--accent-warm) 72%, transparent); }
  .faded { opacity: .22; }

  .lens { padding: 24px 20px; background: var(--gradient); color: var(--text-1); }
  .lens-top { color: color-mix(in srgb, white 65%, transparent); }
  .lens-name { margin-top: 48px; font-family: var(--display); font-size: 24px; line-height: 1; letter-spacing: -.035em; font-weight: 700; }
  .lens-bars { display: flex; gap: 5px; margin-top: 34px; }
  .lens-bars span { height: 5px; flex: 1; border-radius: 99px; background: color-mix(in srgb, white 72%, transparent); }
  .lens-bars span:nth-child(3) { opacity: .3; }
  .lens-copy { margin-top: 26px; color: color-mix(in srgb, white 68%, transparent); font-size: 12px; line-height: 1.55; }

  .principle { max-width: 1180px; margin: 0 auto; padding: 40px 48px 160px; text-align: center; }
  .principle p { font-family: var(--display); font-size: clamp(34px, 4vw, 54px); line-height: 1; letter-spacing: -.045em; font-weight: 600; }
  .principle span { color: var(--text-2); }

  /* The original CTA treatment: clean gradient field, no oversized transparent logo. */
  .climax { background: var(--gradient); }
  .climax-inner { max-width: 1180px; margin: 0 auto; padding: 150px 48px 120px; }
  .climax h2 { max-width: 620px; font-family: var(--display); font-size: clamp(48px, 6vw, 80px); line-height: .95; letter-spacing: -.045em; font-weight: 700; }
  .climax p { max-width: 510px; margin-top: 26px; color: color-mix(in srgb, var(--text-1) 82%, transparent); font-size: 16px; line-height: 1.65; }
  .climax .btn { margin-top: 38px; }

  .site-footer { border-top: 2px solid var(--hairline); }
  .footer-inner { max-width: 1180px; margin: 0 auto; padding: 30px 48px; display: flex; align-items: center; justify-content: space-between; gap: 30px; }
  .footer-wordmark { font-family: var(--display); font-size: 16px; font-weight: 700; }
  .footer-inner nav { display: flex; gap: 26px; }
  .footer-inner nav a, .footer-copy { color: var(--text-2); font-size: 11px; }
  .footer-inner nav a:hover { color: var(--text-1); }

  @media (prefers-reduced-motion: no-preference) {
    .orb-one { animation: drift-one 9s ease-in-out infinite alternate; }
    .orb-two { animation: drift-two 11s ease-in-out infinite alternate; }
    .orb-three { animation: drift-three 8s ease-in-out infinite alternate; }
    .ring-one { animation: ring-one 15s ease-in-out infinite alternate; }
    .ring-two { animation: ring-two 18s ease-in-out infinite alternate; }
    .art-core { animation: core-pulse 7s ease-in-out infinite; }
    @keyframes drift-one { to { transform: rotate(-12deg) translate(2%, -4%) scale(1.04); } }
    @keyframes drift-two { to { transform: rotate(34deg) translate(8%, 5%) scale(.96); } }
    @keyframes drift-three { to { transform: rotate(-26deg) translate(18%, -4%) scale(1.06); } }
    @keyframes ring-one { to { transform: rotate(-8deg) scaleX(1.32) translate(1%, -2%); } }
    @keyframes ring-two { to { transform: rotate(42deg) scaleX(1.03) translate(-2%, 2%); } }
    @keyframes core-pulse { 50% { transform: scale(1.08); } }
  }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; padding-top: 70px; }
    .hero-copy { max-width: 720px; }
    .hero-art { min-height: 520px; }
    .demo { grid-template-columns: 1fr; gap: 16px; }
    .lens { max-width: 360px; justify-self: center; width: 100%; }
    .focused { margin-top: 0; }
  }

  @media (max-width: 640px) {
    .hero, .framework, .principle { padding-left: 22px; padding-right: 22px; }
    .hero { padding-top: 48px; padding-bottom: 65px; }
    h1 { font-size: clamp(52px, 15vw, 74px); }
    .hero-actions { flex-wrap: wrap; }
    .hero-art { min-height: 390px; }
    .framework { padding-top: 105px; padding-bottom: 105px; }
    .framework-heading { margin-bottom: 48px; }
    .signal-field { min-height: 220px; padding: 18px; }
    .principle { padding-bottom: 105px; }
    .climax-inner { padding: 105px 22px 90px; }
    .footer-inner { padding: 26px 22px; flex-wrap: wrap; }
    .footer-copy { width: 100%; }
  }
</style>
