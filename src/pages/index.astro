---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout title="OurPortfolios — learn how to evaluate companies">
  <Navbar variant="marketing" />

  <main>
    <section class="hero" aria-label="OurPortfolios introduction">
      <div class="hero-copy">
        <p class="eyebrow">Company research, with a method</p>
        <h1>Learn how to <em>evaluate</em> a company.</h1>
        <p class="hero-lede">OurPortfolios turns established investment frameworks into a practical way to research any company.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="https://app.ourportfolios.net">Start exploring</a>
          <a class="btn btn-ghost" href="#framework">See how it works</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="visual-plane plane-back"></div>
        <div class="visual-plane plane-mid">
          <div class="plane-line line-one"></div><div class="plane-line line-two"></div><div class="plane-line line-three"></div>
        </div>
        <div class="visual-plane plane-front">
          <span class="visual-tag">FRAMEWORK</span>
          <div class="visual-bars"><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="visual-accent"></div>
      </div>
    </section>

    <section class="problem" aria-labelledby="problem-title">
      <div class="section-intro">
        <p class="eyebrow">The problem</p>
        <h2 id="problem-title">The market gives you <em>everything.</em></h2>
      </div>
      <div class="noise-field" aria-hidden="true">
        <span>Revenue</span><span>ROE</span><span>Margins</span><span>Growth</span>
        <span>P/E</span><span>FCF</span><span>Debt</span><span>EPS</span>
        <span>Valuation</span><span>Guidance</span><span>Price</span><span>Beta</span>
      </div>
      <p class="problem-close">It does not tell you <strong>how to evaluate it.</strong></p>
    </section>

    <section class="framework" id="framework" aria-labelledby="framework-title">
      <div class="section-intro framework-intro">
        <p class="eyebrow">Frameworks</p>
        <h2 id="framework-title">Learn a way to <em>think.</em></h2>
        <p>A framework captures what an investor looks for, why it matters, and how to use the information when researching a company.</p>
      </div>
      <div class="framework-switcher" role="tablist" aria-label="Choose a framework">
        <button class="framework-tab is-active" data-framework="buffett" role="tab" aria-selected="true">Warren Buffett</button>
        <button class="framework-tab" data-framework="lynch" role="tab" aria-selected="false">Peter Lynch</button>
        <button class="framework-tab" data-framework="technical" role="tab" aria-selected="false">Technical</button>
      </div>
      <div class="framework-demo" data-framework-demo>
        <div class="demo-topline"><span>Company research</span><span class="demo-framework">Warren Buffett</span></div>
        <div class="research-map">
          <div class="research-item" data-area="business"><span>Business</span><b></b></div>
          <div class="research-item" data-area="financials"><span>Financial strength</span><b></b></div>
          <div class="research-item" data-area="growth"><span>Growth</span><b></b></div>
          <div class="research-item" data-area="valuation"><span>Valuation</span><b></b></div>
          <div class="research-item" data-area="capital"><span>Capital allocation</span><b></b></div>
          <div class="research-item" data-area="technical"><span>Technical</span><b></b></div>
        </div>
        <div class="demo-caption"><span>All research remains available.</span><strong>The framework changes what gets your attention first.</strong></div>
        <div class="cursor-indicator" aria-hidden="true"><span></span></div>
      </div>
    </section>

    <section class="framework-library" aria-labelledby="library-title">
      <div class="library-copy">
        <p class="eyebrow">A library of approaches</p>
        <h2 id="library-title">Start with someone else's method. <em>Make it yours.</em></h2>
      </div>
      <div class="library-list">
        <article class="library-item"><span>01</span><div><strong>Warren Buffett</strong><p>Quality, economics, valuation and capital allocation.</p></div><b>↗</b></article>
        <article class="library-item"><span>02</span><div><strong>Peter Lynch</strong><p>Growth, business understanding and valuation.</p></div><b>↗</b></article>
        <article class="library-item"><span>03</span><div><strong>Technical analysis</strong><p>Price, momentum and market behaviour.</p></div><b>↗</b></article>
      </div>
    </section>

    <section class="product" aria-labelledby="product-title">
      <div class="product-heading">
        <p class="eyebrow">The research platform</p>
        <h2 id="product-title">Everything around the company.<br /><em>Nothing in the way.</em></h2>
        <p>Company research, financial statements, charts, comparisons and screening, connected by the same framework.</p>
      </div>
      <div class="product-stage" aria-hidden="true">
        <div class="product-nav"><span class="active">Company</span><span>Financials</span><span>Charts</span><span>Compare</span><span>Screen</span></div>
        <div class="product-main">
          <div class="product-chart"><div class="chart-grid"></div><svg viewBox="0 0 620 300" preserveAspectRatio="none"><path d="M0 252 C56 242 78 206 126 214 S198 260 244 202 S318 122 362 154 S418 194 462 118 S522 92 620 42" /></svg></div>
          <div class="product-side"><div></div><div class="selected"></div><div></div></div>
        </div>
        <div class="product-footer"><span>Framework</span><strong>Buffett</strong><span>Applied to research</span></div>
      </div>
    </section>

    <section class="principle" aria-label="OurPortfolios principle">
      <p>Don't outsource the decision.<br /><span>Build the reasoning.</span></p>
    </section>

    <section class="climax" aria-label="Start exploring">
      <div class="climax-inner">
        <h2>Roll credits on guesswork.</h2>
        <p>Every number explained, every chart annotated, every claim sourced. The methodology is open-source, on the record, and free to check.</p>
        <a class="btn btn-invert" href="https://app.ourportfolios.net">Start exploring</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-wordmark">OurPortfolios</span>
      <nav aria-label="Footer"><a href="https://app.ourportfolios.net/tickers">Markets</a><a href="https://app.ourportfolios.net/industry">Analysis</a><a href="https://app.ourportfolios.net/framework">Method</a></nav>
      <span class="footer-copy">2026 OurPortfolios</span>
    </div>
  </footer>
</BaseLayout>

<script>
  const demo = document.querySelector<HTMLElement>("[data-framework-demo]");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".framework-tab")];
  const names: Record<string, string> = { buffett: "Warren Buffett", lynch: "Peter Lynch", technical: "Technical" };
  const focus: Record<string, string[]> = {
    buffett: ["business", "financials", "valuation", "capital"],
    lynch: ["business", "growth", "valuation"],
    technical: ["technical", "growth"],
  };
  if (demo) {
    const map = demo.querySelector<HTMLElement>(".research-map");
    const label = demo.querySelector<HTMLElement>(".demo-framework");
    const cursor = demo.querySelector<HTMLElement>(".cursor-indicator");
    const setFramework = (name: string) => {
      demo.dataset.activeFramework = name;
      if (label) label.textContent = names[name] ?? names.buffett;
      demo.querySelectorAll<HTMLElement>(".research-item").forEach((item) => item.dataset.focused = String((focus[name] ?? focus.buffett).includes(item.dataset.area ?? "")));
      tabs.forEach((tab) => { const active = tab.dataset.framework === name; tab.classList.toggle("is-active", active); tab.setAttribute("aria-selected", String(active)); });
    };
    tabs.forEach((tab) => tab.addEventListener("click", () => setFramework(tab.dataset.framework ?? "buffett")));
    setFramework("buffett");
    map?.addEventListener("pointermove", (event) => {
      if (!cursor) return;
      const rect = map.getBoundingClientRect();
      const x = Math.max(0, Math.min(100, ((event.clientX - rect.left) / rect.width) * 100));
      cursor.style.left = `${x}%`; cursor.style.opacity = "1";
    });
    map?.addEventListener("pointerleave", () => { if (cursor) cursor.style.opacity = "0"; });
  }
</script>

<style>
  :global(html) { scroll-behavior: smooth; }
  h1,h2,p { margin: 0; }
  em { color: var(--accent-warm); font-style: normal; }
  .eyebrow { margin-bottom: 22px; color: var(--text-2); font-size: 11px; font-weight: 600; letter-spacing: .11em; text-transform: uppercase; }
  .hero { min-height: calc(100svh - 64px); max-width: 1360px; margin: 0 auto; padding: 64px 48px 72px; display: grid; grid-template-columns: minmax(430px,.8fr) minmax(560px,1.2fr); align-items: center; gap: 56px; }
  .hero-copy { position: relative; z-index: 2; max-width: 600px; }
  h1 { max-width: 680px; font-family: var(--display); font-size: clamp(64px,7vw,104px); line-height: .88; letter-spacing: -.06em; font-weight: 700; text-wrap: balance; }
  .hero-lede { max-width: 480px; margin-top: 34px; color: var(--text-2); font-size: 17px; line-height: 1.65; }
  .hero-actions { display: flex; gap: 10px; margin-top: 38px; }
  .hero-visual { position: relative; height: min(650px,72vh); min-height: 500px; perspective: 1200px; isolation: isolate; }
  .visual-plane { position: absolute; border: 1px solid color-mix(in srgb,var(--text-1) 12%,transparent); border-radius: 28px; transform-style: preserve-3d; overflow: hidden; }
  .plane-back { width: 76%; height: 72%; top: 8%; right: 4%; transform: rotateY(-22deg) rotateZ(8deg); background: linear-gradient(140deg,#202a33 0%,#46596a 45%,#7c8f9f 100%); }
  .plane-mid { width: 73%; height: 70%; top: 15%; right: 13%; transform: rotateY(-22deg) rotateZ(-5deg) translateZ(35px); background: linear-gradient(135deg,#161c22 0%,#303c47 52%,#9a6347 100%); }
  .plane-front { width: 69%; height: 67%; top: 23%; right: 20%; transform: rotateY(-22deg) rotateZ(5deg) translateZ(80px); background: linear-gradient(140deg,#12171c 0%,#1c252d 48%,#ad704b 100%); padding: 42px; }
  .plane-line { position: absolute; height: 1px; left: 8%; right: 8%; background: color-mix(in srgb,white 22%,transparent); transform: rotate(-6deg); }.line-one{top:35%}.line-two{top:50%;width:70%}.line-three{top:65%;width:52%}
  .visual-tag { position: absolute; top: 40px; left: 42px; font-size: 10px; letter-spacing: .13em; font-weight: 600; color: color-mix(in srgb,white 68%,transparent); }
  .visual-bars { position: absolute; left: 42px; right: 42px; bottom: 42px; display: flex; align-items: end; gap: 12px; height: 44%; }.visual-bars i { flex: 1; border-radius: 7px 7px 0 0; background: linear-gradient(180deg,color-mix(in srgb,var(--accent-warm) 82%,white),color-mix(in srgb,var(--accent-warm) 42%,transparent)); }.visual-bars i:nth-child(1){height:35%;opacity:.38}.visual-bars i:nth-child(2){height:56%;opacity:.52}.visual-bars i:nth-child(3){height:42%;opacity:.68}.visual-bars i:nth-child(4){height:84%}
  .visual-accent { position:absolute; width:30%; aspect-ratio:1; right:6%; top:4%; border-radius:50%; background:radial-gradient(circle,color-mix(in srgb,var(--accent-warm) 65%,transparent),transparent 68%); filter:blur(22px); opacity:.5; }

  .problem,.framework,.framework-library,.product,.principle { max-width:1180px; margin:0 auto; }
  .problem { padding:150px 48px 170px; }.section-intro h2 { max-width:850px; font-family:var(--display); font-size:clamp(50px,5.7vw,78px); line-height:.92; letter-spacing:-.055em; font-weight:700; }
  .noise-field { margin-top:70px; min-height:300px; display:grid; grid-template-columns:repeat(4,1fr); gap:1px; overflow:hidden; border:1px solid var(--hairline); background:var(--hairline); border-radius:18px; }.noise-field span { display:grid; place-items:center; min-height:74px; background:var(--surface-1); color:color-mix(in srgb,var(--text-2) 58%,transparent); font-family:var(--display); font-size:clamp(16px,2vw,24px); letter-spacing:-.03em; }.noise-field span:nth-child(3n){color:var(--text-1)}.noise-field span:nth-child(5n){background:var(--surface-2)}
  .problem-close { margin-top:34px; color:var(--text-2); font-size:18px; }.problem-close strong{color:var(--text-1);font-weight:600}

  .framework { padding:120px 48px 160px; }.framework-intro{max-width:720px}.framework-intro>p:last-child{max-width:600px;margin-top:24px;color:var(--text-2);font-size:16px;line-height:1.65}
  .framework-switcher{display:flex;gap:8px;margin:52px 0 18px}.framework-tab{padding:10px 17px;border:1px solid var(--hairline);border-radius:999px;color:var(--text-2);font-size:13px;font-weight:600;transition:.25s}.framework-tab:hover{color:var(--text-1)}.framework-tab.is-active{color:#0b0d10;background:var(--text-1);border-color:var(--text-1)}
  .framework-demo{position:relative;padding:24px;background:var(--surface-1);border:1px solid var(--hairline);border-radius:20px;overflow:hidden}.demo-topline{display:flex;justify-content:space-between;color:var(--text-2);font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase}.demo-framework{color:var(--accent-warm)}
  .research-map{position:relative;margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:150px;gap:10px;padding:10px;border-radius:13px;background:var(--canvas);overflow:hidden}.research-item{position:relative;display:flex;align-items:flex-end;padding:18px;border-radius:10px;background:var(--surface-2);overflow:hidden;border:1px solid transparent;transition:transform .45s var(--ease-film),background .45s var(--ease-film),border-color .45s}.research-item span{position:relative;z-index:1;color:var(--text-2);font-size:14px;font-weight:600}.research-item b{position:absolute;left:18px;top:20px;width:42%;height:4px;border-radius:999px;background:color-mix(in srgb,var(--text-2) 20%,transparent);box-shadow:0 18px 0 color-mix(in srgb,var(--text-2) 11%,transparent),42px 36px 0 color-mix(in srgb,var(--text-2) 8%,transparent)}.research-item[data-focused="true"]{background:linear-gradient(145deg,#1d252d,color-mix(in srgb,var(--accent-warm) 18%,var(--surface-2)));border-color:color-mix(in srgb,var(--accent-warm) 38%,transparent);transform:translateY(-3px)}.research-item[data-focused="true"] b{background:color-mix(in srgb,var(--accent-warm) 78%,white);box-shadow:0 18px 0 color-mix(in srgb,var(--accent-warm) 35%,transparent),42px 36px 0 color-mix(in srgb,var(--accent-warm) 22%,transparent)}
  .demo-caption{display:flex;justify-content:space-between;gap:24px;padding:18px 4px 2px;color:var(--text-2);font-size:13px}.demo-caption strong{color:var(--text-1);font-weight:500}.cursor-indicator{position:absolute;z-index:3;top:62px;bottom:46px;width:1px;left:50%;opacity:0;background:linear-gradient(180deg,transparent,var(--accent-warm),transparent);transition:opacity .2s;pointer-events:none}.cursor-indicator span{position:absolute;top:50%;left:50%;width:12px;height:12px;transform:translate(-50%,-50%);border-radius:50%;background:var(--accent-warm);box-shadow:0 0 0 6px color-mix(in srgb,var(--accent-warm) 12%,transparent)}

  .framework-library{padding:80px 48px 170px;display:grid;grid-template-columns:.85fr 1.15fr;gap:100px}.library-copy h2{font-family:var(--display);font-size:clamp(42px,4.5vw,62px);line-height:.94;letter-spacing:-.05em}.library-list{border-top:1px solid var(--hairline)}.library-item{display:grid;grid-template-columns:40px 1fr 20px;gap:18px;align-items:center;padding:28px 0;border-bottom:1px solid var(--hairline)}.library-item>span{color:var(--text-2);font-size:11px}.library-item strong{font-family:var(--display);font-size:21px;letter-spacing:-.025em}.library-item p{margin-top:5px;color:var(--text-2);font-size:13px}.library-item>b{color:var(--accent-warm);font-size:18px;font-weight:400}

  .product{padding:80px 48px 160px}.product-heading{max-width:760px}.product-heading>p:last-child{max-width:520px;margin-top:24px;color:var(--text-2);font-size:16px;line-height:1.65}.product-stage{margin-top:58px;border:1px solid var(--hairline);border-radius:20px;overflow:hidden;background:var(--surface-1)}.product-nav{display:flex;border-bottom:1px solid var(--hairline);overflow:hidden}.product-nav span{padding:18px 24px;color:var(--text-2);font-size:13px;white-space:nowrap}.product-nav .active{color:var(--text-1);border-bottom:2px solid var(--accent-warm)}.product-main{display:grid;grid-template-columns:1.7fr .55fr;min-height:400px}.product-chart{position:relative;margin:32px;overflow:hidden;border-radius:16px;background:var(--surface-2)}.chart-grid{position:absolute;inset:0;background:linear-gradient(to right,transparent 49.8%,var(--hairline) 50%,transparent 50.2%),linear-gradient(to bottom,transparent 49.8%,var(--hairline) 50%,transparent 50.2%);opacity:.35}.product-chart svg{position:absolute;inset:16% 7% 10%;width:86%;height:74%;overflow:visible}.product-chart path{fill:none;stroke:url(#missing-gradient);stroke:var(--accent-warm);stroke-width:5;stroke-linecap:round}.product-side{padding:32px 26px;border-left:1px solid var(--hairline);display:flex;flex-direction:column;gap:12px;justify-content:center}.product-side div{height:82px;border:1px solid var(--hairline);border-radius:14px;background:var(--surface-2)}.product-side .selected{border-color:color-mix(in srgb,var(--accent-warm) 38%,transparent);background:color-mix(in srgb,var(--accent-warm) 7%,var(--surface-2))}.product-footer{display:flex;gap:18px;padding:18px 28px;border-top:1px solid var(--hairline);color:var(--text-2);font-size:12px}.product-footer strong{color:var(--accent-warm);font-weight:600}.product-footer span:last-child{margin-left:auto}

  .principle{padding:50px 48px 170px;text-align:center}.principle p{font-family:var(--display);font-size:clamp(38px,4.5vw,62px);line-height:.98;letter-spacing:-.05em;font-weight:600}.principle span{color:var(--text-2)}
  .climax{background:var(--gradient)}.climax-inner{max-width:1180px;margin:0 auto;padding:150px 48px 120px}.climax h2{max-width:620px;font-family:var(--display);font-size:clamp(48px,6vw,80px);line-height:.95;letter-spacing:-.045em;font-weight:700}.climax p{max-width:510px;margin-top:26px;color:color-mix(in srgb,var(--text-1) 82%,transparent);font-size:16px;line-height:1.65}.climax .btn{margin-top:38px}
  .site-footer{border-top:1px solid var(--hairline)}.footer-inner{max-width:1180px;margin:0 auto;padding:30px 48px;display:flex;align-items:center;justify-content:space-between;gap:30px}.footer-wordmark{font-family:var(--display);font-size:16px;font-weight:700}.footer-inner nav{display:flex;gap:26px}.footer-inner nav a,.footer-copy{color:var(--text-2);font-size:11px}.footer-inner nav a:hover{color:var(--text-1)}

  @media (prefers-reduced-motion:no-preference){.plane-back{animation:float-back 12s ease-in-out infinite alternate}.plane-mid{animation:float-mid 10s ease-in-out infinite alternate}.plane-front{animation:float-front 8s ease-in-out infinite alternate}.visual-accent{animation:breathe 7s ease-in-out infinite}@keyframes float-back{to{transform:rotateY(-18deg) rotateZ(5deg) translateY(-8px)}}@keyframes float-mid{to{transform:rotateY(-25deg) rotateZ(-2deg) translateZ(35px) translateY(8px)}}@keyframes float-front{to{transform:rotateY(-19deg) rotateZ(7deg) translateZ(80px) translateY(-5px)}}@keyframes breathe{50%{transform:scale(1.18);opacity:.7}}}
  @media (max-width:980px){.hero{grid-template-columns:1fr;padding-top:70px}.hero-copy{max-width:760px}.hero-visual{min-height:520px;height:58vh}.framework-library{grid-template-columns:1fr;gap:60px}.product-main{min-height:350px}}
  @media (max-width:680px){.hero,.problem,.framework,.framework-library,.product,.principle{padding-left:22px;padding-right:22px}.hero{padding-top:48px;padding-bottom:70px}.hero-visual{min-height:380px;height:55vh}.plane-front{padding:24px}.visual-tag{top:24px;left:24px}.visual-bars{left:24px;right:24px;bottom:24px}.problem,.framework{padding-top:105px;padding-bottom:110px}.noise-field{grid-template-columns:repeat(2,1fr);margin-top:48px}.research-map{grid-template-columns:repeat(2,1fr);grid-auto-rows:120px}.demo-caption{flex-direction:column;gap:6px}.framework-switcher{overflow-x:auto;padding-bottom:3px}.framework-tab{flex:0 0 auto}.framework-library,.product{padding-top:70px;padding-bottom:110px}.product-main{grid-template-columns:1fr}.product-side{display:none}.product-chart{min-height:300px}.product-footer span:last-child{display:none}.principle{padding-bottom:110px}.climax-inner{padding:105px 22px 90px}.footer-inner{padding:26px 22px;flex-wrap:wrap}.footer-copy{width:100%}}
</style>
