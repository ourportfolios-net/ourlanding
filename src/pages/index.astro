---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout title="OurPortfolios — see what matters">
  <Navbar variant="marketing" />

  <main>
    <section class="hero">
      <div class="hero-art" aria-hidden="true">
        <div class="art-ring ring-a"></div>
        <div class="art-ring ring-b"></div>
        <div class="art-glass"></div>
        <div class="art-light"></div>
      </div>
      <div class="shell hero-inner">
        <p class="eyebrow">OurPortfolios</p>
        <h1>See what<br /><span>matters.</span></h1>
        <p class="hero-copy">Investing is complex. OurPortfolios removes the unnecessary noise.</p>
        <a class="btn btn-primary" href="https://app.ourportfolios.net">Start exploring</a>
      </div>
    </section>

    <section class="idea">
      <div class="shell">
        <div class="idea-heading">
          <p class="eyebrow">One company. Different lenses.</p>
          <h2>The right numbers<br />depend on how you think.</h2>
        </div>

        <div class="lens-demo">
          <div class="demo-visual" aria-hidden="true">
            <div class="visual-grid"></div>
            <div class="visual-company">NVDA</div>
            <div class="visual-orbit orbit-1"></div>
            <div class="visual-orbit orbit-2"></div>
            <div class="visual-orbit orbit-3"></div>
            <div class="visual-node node-quality">Quality</div>
            <div class="visual-node node-growth">Growth</div>
            <div class="visual-node node-value">Value</div>
          </div>
          <div class="demo-copy">
            <p>Frameworks let you look at a company through the metrics you actually care about.</p>
            <div class="lens-list">
              <button class="lens is-active" data-lens="quality" type="button"><span>01</span><strong>Quality</strong><em>Durability & economics</em></button>
              <button class="lens" data-lens="growth" type="button"><span>02</span><strong>Growth</strong><em>Expansion & momentum</em></button>
              <button class="lens" data-lens="value" type="button"><span>03</span><strong>Value</strong><em>Price & cash generation</em></button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="product">
      <div class="shell">
        <div class="product-heading">
          <p class="eyebrow">Same company. Less noise.</p>
          <h2>What rises to the surface<br /><span>changes with the lens.</span></h2>
        </div>

        <div class="product-demo">
          <div class="demo-header">
            <div class="company"><span class="company-mark">N</span><strong>NVIDIA</strong><span>NVDA</span></div>
            <span class="demo-context">Quality framework</span>
          </div>
          <div class="demo-content">
            <div class="signal">
              <span>Quality</span>
              <strong>8.7</strong>
              <p>Strong economics with durable returns.</p>
            </div>
            <div class="metric-focus">
              <div><span>ROIC</span><strong>81.2%</strong></div>
              <div><span>Gross margin</span><strong>71.0%</strong></div>
              <div><span>FCF margin</span><strong>24.8%</strong></div>
            </div>
            <div class="quiet-chart" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
          </div>
          <div class="demo-footer"><span>Framework: Quality</span><span>Metrics selected for this lens</span></div>
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="shell closing-inner">
        <p class="eyebrow">Keep the complexity. Lose the noise.</p>
        <h2>Research with<br /><span>a point of view.</span></h2>
        <a class="btn btn-primary" href="https://app.ourportfolios.net">Start exploring</a>
      </div>
      <div class="closing-art" aria-hidden="true"><div></div><div></div><div></div></div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <strong>OurPortfolios</strong>
      <span>Built to help you understand companies.</span>
      <span>2026</span>
    </div>
  </footer>
</BaseLayout>

<script>
  const lenses = document.querySelectorAll<HTMLButtonElement>(".lens");
  const context = document.querySelector<HTMLElement>(".demo-context");
  const demo = document.querySelector<HTMLElement>(".product-demo");
  const labels: Record<string, string> = { quality: "Quality framework", growth: "Growth framework", value: "Value framework" };
  lenses.forEach((lens) => lens.addEventListener("click", () => {
    lenses.forEach((item) => item.classList.remove("is-active"));
    lens.classList.add("is-active");
    const key = lens.dataset.lens || "quality";
    if (context) context.textContent = labels[key];
    demo?.setAttribute("data-lens", key);
  }));
</script>

<style>
  .shell { width: min(1160px, calc(100% - 64px)); margin-inline: auto; }
  .eyebrow { margin: 0 0 22px; font-size: 10px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--text-2); }
  h1, h2, strong { font-family: var(--display); }

  /* The page has four jobs: introduce the idea, explain frameworks, prove it, close. */
  .hero { min-height: calc(100vh - 64px); position: relative; display: grid; place-items: center; overflow: hidden; }
  .hero-inner { position: relative; z-index: 2; padding-block: 100px; }
  .hero h1 { max-width: 850px; margin: 0 0 30px; font-size: clamp(76px, 12vw, 168px); line-height: .84; letter-spacing: -.065em; font-weight: 800; color: var(--text-1); }
  .hero h1 span, .product-heading h2 span, .closing h2 span { color: var(--accent-warm); }
  .hero-copy { max-width: 430px; margin: 0 0 34px; color: var(--text-2); font-size: 16px; line-height: 1.6; }
  .hero-art { position: absolute; width: min(760px, 70vw); height: min(760px, 70vw); right: -90px; top: 50%; transform: translateY(-50%); opacity: .62; pointer-events: none; }
  .art-ring { position: absolute; inset: 12%; border: 1px solid color-mix(in srgb, var(--text-2) 11%, transparent); border-radius: 50%; animation: drift 14s ease-in-out infinite alternate; }
  .ring-b { inset: 25%; transform: rotate(45deg) scaleX(.68); border-color: color-mix(in srgb, var(--accent-warm) 24%, transparent); animation-duration: 19s; }
  .art-glass { position: absolute; width: 42%; height: 58%; right: 17%; top: 20%; border: 1px solid color-mix(in srgb, var(--text-1) 9%, transparent); border-radius: 48% 52% 46% 54%; transform: rotate(24deg); background: linear-gradient(135deg, color-mix(in srgb, var(--accent-warm) 7%, transparent), transparent 45%); backdrop-filter: blur(3px); }
  .art-light { position: absolute; width: 40%; height: 40%; right: 20%; top: 28%; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent-warm) 9%, transparent), transparent 68%); filter: blur(24px); animation: pulse 8s ease-in-out infinite alternate; }
  @keyframes drift { to { transform: translate3d(12px, -10px, 0) rotate(5deg); } }
  @keyframes pulse { to { transform: scale(1.18); opacity: .7; } }

  .idea { padding: 180px 0; border-top: 1px solid var(--hairline); }
  .idea-heading { max-width: 720px; margin-bottom: 90px; }
  .idea-heading h2, .product-heading h2, .closing h2 { margin: 0; font-size: clamp(48px, 7vw, 92px); line-height: .94; letter-spacing: -.055em; font-weight: 750; color: var(--text-1); }
  .lens-demo { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); min-height: 520px; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .demo-visual { position: relative; overflow: hidden; min-height: 520px; background: var(--surface-1); }
  .visual-grid { position: absolute; inset: 0; opacity: .12; background-image: linear-gradient(var(--text-2) 1px, transparent 1px), linear-gradient(90deg, var(--text-2) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(circle at center, black, transparent 70%); }
  .visual-company { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 112px; height: 112px; display: grid; place-items: center; border: 1px solid color-mix(in srgb, var(--accent-warm) 32%, var(--hairline)); border-radius: 50%; font: 700 24px var(--display); letter-spacing: -.04em; background: var(--canvas); z-index: 2; }
  .visual-orbit { position: absolute; left: 50%; top: 50%; border: 1px solid color-mix(in srgb, var(--text-2) 12%, transparent); border-radius: 50%; transform: translate(-50%, -50%); animation: orbit 18s linear infinite; }
  .orbit-1 { width: 260px; height: 260px; } .orbit-2 { width: 390px; height: 240px; transform: translate(-50%, -50%) rotate(52deg); animation-duration: 24s; } .orbit-3 { width: 500px; height: 330px; transform: translate(-50%, -50%) rotate(-31deg); animation-duration: 31s; }
  @keyframes orbit { to { rotate: 360deg; } }
  .visual-node { position: absolute; padding: 9px 12px; border: 1px solid var(--hairline); background: var(--canvas); font-size: 10px; color: var(--text-2); z-index: 3; }
  .node-quality { left: 20%; top: 28%; } .node-growth { right: 16%; top: 19%; } .node-value { right: 23%; bottom: 19%; }
  .demo-copy { padding: 55px 50px; display: flex; flex-direction: column; justify-content: space-between; border-left: 1px solid var(--hairline); }
  .demo-copy > p { max-width: 320px; margin: 0; font-size: 18px; line-height: 1.5; color: var(--text-1); }
  .lens-list { border-top: 1px solid var(--hairline); }
  .lens { width: 100%; display: grid; grid-template-columns: 30px 1fr; grid-template-rows: auto auto; column-gap: 12px; padding: 17px 0; border: 0; border-bottom: 1px solid var(--hairline); background: transparent; text-align: left; color: var(--text-2); cursor: pointer; }
  .lens span { grid-row: 1 / 3; font-size: 9px; padding-top: 3px; } .lens strong { font-size: 15px; color: var(--text-1); } .lens em { font-style: normal; font-size: 10px; margin-top: 3px; } .lens.is-active strong { color: var(--accent-warm); } .lens.is-active span { color: var(--accent-warm); }

  .product { padding: 170px 0; }
  .product-heading { margin-bottom: 70px; }
  .product-demo { border: 1px solid var(--hairline); background: var(--surface-1); }
  .demo-header { height: 68px; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; border-bottom: 1px solid var(--hairline); }
  .company { display: flex; align-items: center; gap: 10px; font-size: 13px; } .company-mark { width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid var(--hairline); font: 700 14px var(--display); } .company > span:last-child { color: var(--text-2); font-size: 10px; }
  .demo-context { color: var(--text-2); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .demo-content { display: grid; grid-template-columns: .9fr 1fr 1.25fr; min-height: 320px; }
  .signal { padding: 45px 35px; border-right: 1px solid var(--hairline); } .signal span { font-size: 10px; text-transform: uppercase; letter-spacing: .1em; color: var(--text-2); } .signal strong { display: block; margin: 14px 0 12px; font-size: 70px; line-height: .85; letter-spacing: -.07em; } .signal p { max-width: 180px; margin: 0; color: var(--text-2); font-size: 11px; line-height: 1.5; }
  .metric-focus { padding: 35px; display: flex; flex-direction: column; justify-content: center; border-right: 1px solid var(--hairline); } .metric-focus div { display: flex; align-items: baseline; justify-content: space-between; padding: 17px 0; border-bottom: 1px solid var(--hairline); } .metric-focus span { font-size: 11px; color: var(--text-2); } .metric-focus strong { font-size: 22px; letter-spacing: -.03em; }
  .quiet-chart { align-self: end; height: 180px; margin: 0 35px 35px; display: flex; align-items: end; gap: 8px; opacity: .55; } .quiet-chart i { flex: 1; display: block; background: linear-gradient(to top, var(--accent), var(--accent-warm)); border-radius: 2px 2px 0 0; } .quiet-chart i:nth-child(1) { height: 22%; } .quiet-chart i:nth-child(2) { height: 35%; } .quiet-chart i:nth-child(3) { height: 29%; } .quiet-chart i:nth-child(4) { height: 48%; } .quiet-chart i:nth-child(5) { height: 55%; } .quiet-chart i:nth-child(6) { height: 72%; } .quiet-chart i:nth-child(7) { height: 66%; } .quiet-chart i:nth-child(8) { height: 91%; }
  .demo-footer { display: flex; justify-content: space-between; padding: 13px 28px; border-top: 1px solid var(--hairline); color: var(--text-2); font-size: 9px; }

  .closing { position: relative; overflow: hidden; min-height: 650px; display: grid; align-items: center; border-top: 1px solid var(--hairline); }
  .closing-inner { position: relative; z-index: 2; padding-block: 130px; }
  .closing h2 { max-width: 750px; margin-bottom: 42px; }
  .closing-art { position: absolute; width: 680px; height: 680px; right: -80px; top: 50%; transform: translateY(-50%); opacity: .7; pointer-events: none; }
  .closing-art div { position: absolute; inset: 0; border: 1px solid color-mix(in srgb, var(--text-2) 10%, transparent); border-radius: 50%; } .closing-art div:nth-child(2) { inset: 16%; border-color: color-mix(in srgb, var(--accent-warm) 18%, transparent); } .closing-art div:nth-child(3) { inset: 34%; background: radial-gradient(circle, color-mix(in srgb, var(--accent-warm) 7%, transparent), transparent 68%); }
  .site-footer { border-top: 1px solid var(--hairline); } .footer-inner { min-height: 110px; display: grid; grid-template-columns: 1fr 1fr auto; align-items: center; gap: 30px; color: var(--text-2); font-size: 10px; } .footer-inner strong { color: var(--text-1); font-size: 14px; }

  @media (max-width: 800px) {
    .shell { width: min(100% - 40px, 1160px); }
    .hero-art { width: 620px; height: 620px; right: -260px; opacity: .45; }
    .lens-demo { grid-template-columns: 1fr; } .demo-visual { min-height: 430px; } .demo-copy { border-left: 0; border-top: 1px solid var(--hairline); min-height: 430px; }
    .demo-content { grid-template-columns: 1fr 1fr; } .signal { border-bottom: 1px solid var(--hairline); } .metric-focus { border-right: 0; border-bottom: 1px solid var(--hairline); } .quiet-chart { grid-column: 1 / -1; margin-top: 20px; }
    .footer-inner { grid-template-columns: 1fr auto; } .footer-inner span:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
  }
  @media (max-width: 560px) {
    .hero h1 { font-size: 72px; } .hero-copy { font-size: 15px; }
    .idea, .product { padding-block: 110px; } .idea-heading { margin-bottom: 60px; }
    .demo-visual { min-height: 360px; } .visual-company { width: 92px; height: 92px; } .orbit-1 { width: 210px; height: 210px; } .orbit-2 { width: 300px; height: 190px; } .orbit-3 { width: 390px; height: 260px; } .node-quality { left: 7%; } .node-growth { right: 6%; } .node-value { right: 10%; }
    .demo-content { display: block; } .signal, .metric-focus { border-right: 0; } .signal { min-height: 220px; } .quiet-chart { height: 140px; margin: 30px 24px 24px; }
    .demo-footer { gap: 15px; flex-direction: column; }
    .closing { min-height: 560px; } .closing-art { width: 460px; height: 460px; right: -250px; } .closing h2 { font-size: 58px; }
    .footer-inner { display: flex; flex-wrap: wrap; padding-block: 28px; }
  }
  @media (prefers-reduced-motion: reduce) { .art-ring, .art-light, .visual-orbit { animation: none; } }
</style>
